# Maintainer: emoeem
#
# DracPanel is an unofficial Dracula/Alucard desktop web UI for sing-box.
# Source: https://github.com/emoeem/dracpanel (fork of
#         SagerNet/sing-box-dashboard; full source + prebuilt Vite dist in tarball)
#
# The tarball is the source of record: it contains the complete source and the
# prebuilt dist. The package installs only the static UI; the panel backend
# (sing-box-panel) is the runtime dependency and serves /api on 9096.
# The UI also needs sing-box's native API (services.api on 127.0.0.1:9091 with
# a CORS whitelist for 127.0.0.1/localhost:9096). See the installed DEPLOYMENT.md.
#
# Updating: rebuild dist in the source repo, refresh the tarball (which stamps
# SOURCE_COMMIT next to dist/), bump pkgver/pkgrel, update sha256sums,
# regenerate .SRCINFO. `check()` enforces that dist/ and the sources describe
# the same revision, so a stale hand-built dist fails the build instead of
# silently shipping.

pkgname=dracpanel
pkgver=0.1.0
pkgrel=10
pkgdesc='DracPanel: FlClash-style web UI for sing-box (Dracula palette optional)'
arch=('any')
url='https://github.com/emoeem/pkgbuild'
license=('GPL-3.0-or-later')
depends=('sing-box-panel')
makedepends=()
options=('!strip')
provides=('dracula-panel-for-sing-box')
conflicts=('dracula-panel-for-sing-box')
replaces=('dracula-panel-for-sing-box')
install=dracpanel.install
source=("dracpanel-${pkgver}.tar.zst")
sha256sums=('2aa52514ce29c68e9654da44e4049a117c4eabead6f72be9a39ccd91c846aedc')

_json_field() {
    # Pull a top-level string field out of a small JSON file without jq.
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$2" | head -1
}

check() {
    local srcroot="$srcdir/dracpanel-${pkgver}"
    local meta="$srcroot/dist/build-info.json"

    if [[ ! -f "$meta" ]]; then
        error "dist/build-info.json is missing: the prebuilt UI cannot be traced to a source revision"
        return 1
    fi

    local built src_commit version
    built=$(_json_field commit "$meta")
    version=$(_json_field version "$meta")
    src_commit=$(head -1 "$srcroot/SOURCE_COMMIT" 2>/dev/null | tr -d '[:space:]')

    if [[ -n "$version" && "$version" != "$pkgver" ]]; then
        error "dist reports version $version but PKGBUILD declares pkgver=$pkgver"
        return 1
    fi

    # SOURCE_COMMIT may hold a full hash; dist only records the short one.
    if [[ -n "$built" && -n "$src_commit" && "$src_commit" != "$built"* ]]; then
        error "dist was built from $built but the sources are $src_commit"
        return 1
    fi

    if [[ ! -f "$srcroot/dist/licenses/THIRD-PARTY.md" ]]; then
        error "dist/licenses/THIRD-PARTY.md is missing: rebuild with 'pnpm build'"
        return 1
    fi
}

package() {
    local srcroot="$srcdir/dracpanel-${pkgver}"

    install -d "$pkgdir/usr/share/dracpanel/ui"
    cp -a "$srcroot/dist/." "$pkgdir/usr/share/dracpanel/ui/"

    install -Dm644 "$srcroot/DEPLOYMENT.md"         "$pkgdir/usr/share/doc/$pkgname/DEPLOYMENT.md"
    install -Dm644 "$srcroot/NOTICE" "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
    install -Dm644 "$srcroot/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    install -Dm644 /dev/stdin         "$pkgdir/usr/share/dracpanel/panel.json.example" <<'PANEL'
{
  "ui_dir": "/usr/share/dracpanel/ui"
}
PANEL
}
