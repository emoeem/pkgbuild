# Maintainer: emoeem
pkgname=daed-emo
pkgver=1.27.0.r0.gunknown
pkgrel=1
pkgdesc='Modern web dashboard for dae (current upstream, x86-64-v3/AVX2 build)'
arch=('x86_64')
url='https://github.com/daeuniverse/daed'
license=('MIT')
depends=('v2ray-geoip' 'v2ray-domain-list-community')
makedepends=('base-devel' 'clang' 'git' 'go' 'llvm' 'nodejs' 'pnpm')
provides=('daed')
conflicts=('daed' 'daed-git')
source=('git+https://github.com/daeuniverse/daed.git')
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/daed"
  printf '1.27.0.r%s.g%s\n' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$srcdir/daed"

  git submodule update --init --recursive

  git -C wing fetch --depth=1 origin main
  git -C wing checkout --detach FETCH_HEAD
  git -C wing submodule update --init --recursive

  printf '%s\n' 'Using dae-wing main with its pinned dae-core commit for source compatibility.'
  go -C wing/dae-core mod edit -require=github.com/cilium/ebpf@v0.22.0
  (cd wing/dae-core && go mod download github.com/cilium/ebpf@v0.22.0)
  (cd wing && go mod tidy)

  printf '%s\n' 'Patched pinned dae-core to cilium/ebpf v0.22.0 for Linux 7.1+ BTF compatibility.'
  grep -F 'github.com/cilium/ebpf v0.22.0' wing/dae-core/go.mod
  grep -F 'replace github.com/daeuniverse/dae => ./dae-core' wing/go.mod
}

build() {
  cd "$srcdir/daed"
  env GOAMD64=v3 CFLAGS='-O2' CXXFLAGS='-O2' make VERSION="$(pkgver)" MAKEFLAGS="-j$(nproc)"
}

package() {
  cd "$srcdir/daed"

  install -Dm755 daed "$pkgdir/usr/bin/daed"

  # daed searches /usr/share/daed for geo data. Reuse the system-managed
  # v2ray-rules-dat files so rule updates are picked up without repackaging daed.
  install -d "$pkgdir/usr/share/daed"
  ln -s /usr/share/v2ray/geoip.dat "$pkgdir/usr/share/daed/geoip.dat"
  ln -s /usr/share/v2ray/geosite.dat "$pkgdir/usr/share/daed/geosite.dat"

  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/daed.service" <<'EOF'
[Unit]
Description=daed is a integration solution of dae, API and UI.
Documentation=https://github.com/daeuniverse/daed
After=network-online.target docker.service systemd-sysctl.service
Wants=network-online.target
Conflicts=dae.service

[Service]
Type=simple
User=root
LimitNPROC=512
LimitNOFILE=1048576
ExecStart=/usr/bin/daed run -c /etc/daed/
Restart=on-abnormal

[Install]
WantedBy=multi-user.target
EOF
}
