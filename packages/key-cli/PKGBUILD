# Maintainer: emoeem <3353745917@qq.com>
# Rendered by the upstream project as scripts/release.py; dependencies come from
# packaging/dependencies.json. Refresh from the release asset of the same name:
#   https://github.com/StatIndet/key-cli/releases/download/v${pkgver}/PKGBUILD
# shellcheck shell=bash disable=SC2034,SC2154
pkgbase=key-cli
pkgname=('key-cli' 'key-cli-keyboard-access')
pkgver=2026.9.12
pkgrel=1
pkgdesc='Clavis command interface, clipboard backend and keyboard events'
arch=('any')
url='https://github.com/StatIndet/key-cli'
license=('GPL-3.0-or-later')
# Pure Python and udev data contain no ELF debug symbols to split out.
options=('!debug')
makedepends=(python-build python-installer python-setuptools python-wheel)
checkdepends=(python-pytest python-evdev python-pyudev git)
source=("key-cli-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/key-cli-${pkgver}.tar.gz")
sha256sums=('260d5b0ef8a61e75844d91ac0d4006f7b2cb9cc784985fcee2c4668492abf1af')

build() {
    cd "key-cli-${pkgver}" || return
    python -m build --wheel --no-isolation
}

check() {
    cd "key-cli-${pkgver}" || return
    PYTHONPATH=src python -m pytest
    python scripts/check-wheel.py dist/*.whl
}

package_key-cli() {
    depends=('python>=3.10' 'python-evdev>=1.7' 'python-pyudev>=0.24' cliphist wl-clipboard)
    optdepends=('key-cli-keyboard-access: Whole keyboard event device access' 'quickshell: Shell lifecycle and IPC' 'gpu-screen-recorder: Screen recording' 'ffmpeg: Audio recording and GIF conversion' 'libpulse: pactl audio source discovery' 'slurp: Region selection' 'xdg-utils: Open files and query defaults' 'xdg-terminal-exec: Terminal file managers')
    cd "key-cli-${pkgver}" || return
    python -m installer --destdir="${pkgdir}" --prefix=/usr dist/*.whl
    install -Dm644 systemd/user/clavis-clipboard.service "${pkgdir}/usr/lib/systemd/user/clavis-clipboard.service"
    install -Dm644 completions/key.fish "${pkgdir}/usr/share/fish/vendor_completions.d/key.fish"
    install -Dm644 docs/installation.md "${pkgdir}/usr/share/doc/key-cli/installation.md"
}

package_key-cli-keyboard-access() {
    pkgdesc='Optional whole evdev keyboard device access for active local users'
    depends=(systemd)
    cd "key-cli-${pkgver}" || return
    install -Dm644 packaging/udev/71-clavis-keyboard-leds.rules "${pkgdir}/usr/lib/udev/rules.d/71-clavis-keyboard-leds.rules"
    install -Dm644 docs/installation.md "${pkgdir}/usr/share/doc/key-cli-keyboard-access/installation.md"
}
