# Rendered by the upstream project as scripts/release.py; dependencies come from
# packaging/dependencies.json. Refresh from the release asset of the same name:
#   https://github.com/StatIndet/quickshell/releases/download/v${pkgver}/PKGBUILD
# shellcheck shell=bash disable=SC2034,SC2154
pkgbase=clavis-shell
pkgname=('clavis-shell')
pkgver=2026.9.12
pkgrel=1
pkgdesc='Niri desktop shell built with Quickshell and Qt Quick'
arch=('x86_64')
url='https://github.com/StatIndet/quickshell'
license=('GPL-3.0-or-later' 'MIT' 'Apache-2.0' 'MPL-2.0' 'LGPL-3.0-only' 'OFL-1.1')
makedepends=(cmake ninja pkgconf 'qt6-base>=6.8' qt6-declarative qt6-wayland qt6-shadertools qt6-tools qtkeychain-qt6 libpipewire libcava systemd-libs libxkbcommon)
checkdepends=(niri python jq matugen git)
source=("clavis-shell-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/clavis-shell-${pkgver}.tar.gz")
sha256sums=('8f375d7a90ae155682c2b5ec47f830ee9253dcc3e3fdf149386c44bbaaac32aa')

build() {
    cmake -S "clavis-shell-${pkgver}" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \
        -DCLAVIS_CONFIG_INSTALL_DIR=/etc/xdg/quickshell/clavis
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure --no-tests=error
    python "clavis-shell-${pkgver}/scripts/release.py" verify-resources
}

package_clavis-shell() {
    # Runtime backends do not participate in this repository's build or tests.
    depends=(quickshell niri 'key-cli>=2026.9.12' 'keytop>=2026.9.12' 'qt6-base>=6.8' qt6-declarative qt6-svg qt6-wayland qt6-5compat qt6-lottie qt6-location qt6-positioning maplibre-native-qt qtkeychain-qt6 libpipewire libcava systemd-libs libxkbcommon qt6-m3shapes-git ttf-material-symbols-variable bash python coreutils findutils util-linux which jq matugen xdg-utils glib2 libnotify systemd pam sed grep wl-clipboard)
    optdepends=('gpu-screen-recorder: Screen recording through key-cli' 'ffmpeg: Audio recording, ffprobe and GIF conversion' 'libpulse: pactl audio source discovery' 'slurp: Recording region selection' 'grim: Screenshot capture' 'hyprpicker: Color picker' 'awww: Optional wallpaper backend' 'rclone: Cloud upload and backup' 'brightnessctl: Backlight control' 'ddcutil: External display brightness' 'imagemagick: Overview wallpaper cache tool' 'xdg-terminal-exec: Terminal file manager launch' 'ttf-lxgw-wenkai-screen: Default UI font' 'ttf-jetbrains-mono-nerd: Default monospace and numeric font' 'networkmanager: Network controls and nmcli' 'bluez: Bluetooth service' 'upower: Power and battery service' 'pipewire: Audio server' 'wireplumber: Audio session manager when none is installed' 'gsettings-desktop-schemas: Desktop color scheme schema' 'paru: Unused PackageService package counters; not needed by the installer')
    DESTDIR="${pkgdir}" cmake --install build
    install -Dm644 "clavis-shell-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/clavis-shell/LICENSE"
    cp -r "clavis-shell-${pkgver}/licenses" "${pkgdir}/usr/share/licenses/clavis-shell/third-party"
}
