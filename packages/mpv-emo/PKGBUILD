# mpv-Emo Stable — mpv-full baseline plus curated core patches.
# The Omniphony mpv-side integration is part of the core build; liborender is
# loaded at runtime only when its separate engine is installed.

pkgname=mpv-emo
pkgver=0.41.0
pkgrel=1
pkgdesc='mpv-Emo stable: full Linux mpv build with curated core patches'
arch=('x86_64')
license=('GPL-2.0-or-later')
url='https://mpv.io/'
depends=('ffmpeg' 'libass' 'libbluray' 'libplacebo' 'lua' 'pipewire' 'vapoursynth'
         'vulkan-icd-loader' 'wayland' 'zimg' 'alsa-lib' 'jack2' 'libpulse'
         'libva' 'libx11' 'lcms2' 'libarchive' 'libdvdnav' 'rubberband' 'uchardet')
optdepends=('orender: enable the bundled Omniphony spatial-audio decoder at runtime')
makedepends=('meson' 'vulkan-headers' 'wayland-protocols' 'ffnvcodec-headers')
provides=('mpv' 'libmpv.so=2-64')
conflicts=('mpv' 'mpv-full' 'mpv-emo-git')
source=("mpv-${pkgver}.tar.gz::https://github.com/mpv-player/mpv/archive/v${pkgver}.tar.gz")

sha256sums=('ee21092a5ee427353392360929dc64645c54479aefdb5babc5cfbb5fad626209')

prepare() {
    cd "${srcdir}/mpv-${pkgver}"
    local patch_file
    for patch_file in "${startdir}"/patches/*.patch; do
        [[ -f "$patch_file" ]] || continue
        patch -Np1 < "$patch_file"
    done
}
build() {
    cd "${srcdir}/mpv-${pkgver}"
    meson setup build \
        --prefix /usr --libexecdir lib --sbindir bin --buildtype plain \
        --auto-features=auto --wrap-mode nodownload -D b_pie=true -D python.bytecompile=1 \
        -Dgpl=true -Dcplayer=true -Dlibmpv=true -Dbuild-date=false \
        -Dtests=true -Dwin32-threads=disabled -Dorender=enabled -Dvulkan=enabled -Dwayland=enabled \
        -Dcuda-hwaccel=enabled -Dcuda-interop=enabled \
        -Dvapoursynth=enabled -Dzimg=enabled -Dpipewire=enabled \
        -Dpulse=enabled -Dalsa=enabled -Djack=enabled \
        -Ddvdnav=enabled -Dlibbluray=enabled -Dlibavdevice=enabled \
        -Dlcms2=enabled -Drubberband=enabled -Duchardet=enabled \
        -Dlibarchive=enabled -Dx11=enabled -Dvaapi=enabled
    meson compile -C build
}

check() {
    meson test -C build --print-errorlogs
}

package() {
    meson install -C build --destdir "$pkgdir"
}
