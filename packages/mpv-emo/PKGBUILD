# Maintainer: Emo <emoeem@users.noreply.github.com>
# mpv-Emo Stable — mpv-full baseline plus curated core patches.
# The Omniphony mpv-side integration is part of the core build; liborender is
# loaded at runtime only when its separate engine is installed.

pkgname=mpv-emo
pkgver=0.41.0
pkgrel=3
pkgdesc='Full Linux mpv build with curated core patches'
arch=('x86_64')
license=('GPL-2.0-or-later')
url='https://mpv.io/'
depends=(
    "ffmpeg" "gcc-libs" "glibc" "hicolor-icon-theme" "desktop-file-utils" "alsa-lib" "pipewire-jack" "lcms2" "libarchive" "libass" "libbluray"
    "libcaca" "libcdio" "libcdio-paranoia" "libdisplay-info" "libdrm" "libdvdnav" "libdvdread" "libegl" "libgl" "libglvnd"
    "libjpeg-turbo" "libpipewire" "libplacebo" "libpulse" "libsixel" "libva" "libvdpau" "libx11" "libxext"
    "libxfixes" "libxkbcommon" "libxpresent" "libxrandr" "libxss" "libxv" "lua52" "mesa" "mujs" "openal"
    "rubberband" "sdl2" "sh" "sndio" "uchardet" "vapoursynth" "vulkan-icd-loader" "wayland" "zimg" "zlib"
)
optdepends=(
    'orender: enable the bundled Omniphony spatial-audio decoder at runtime'
    'nvidia-utils: hardware accelerated video decoding with CUDA'
    'python: stats-conv and umpv scripts'
    'python-pyqt6: stats-conv script'
    'python-pyqtgraph: stats-conv script'
    'yt-dlp: video-sharing websites playback'
)
makedepends=("meson" "python-docutils" "vulkan-headers" "wayland-protocols" "ffnvcodec-headers" "ladspa")
provides=('mpv' 'libmpv.so=2-64')
conflicts=('mpv' 'mpv-full' 'mpv-emo-git')
source=("mpv-${pkgver}.tar.gz::https://github.com/mpv-player/mpv/archive/v${pkgver}.tar.gz" *.patch)

