# Maintainer: emoeem <3353745917@qq.com>
# Rendered by the upstream project as scripts/release.py; dependencies come from
# packaging/dependencies.json. Refresh from the release asset of the same name:
#   https://github.com/StatIndet/keytop/releases/download/v${pkgver}/PKGBUILD
# The referenced install file is published next to the source tarball:
#   https://github.com/StatIndet/keytop/releases/download/v${pkgver}/keytop-privileged-access.install
# shellcheck shell=bash disable=SC2034,SC2154
pkgbase=keytop
pkgname=('keytop' 'keytop-privileged-access')
pkgver=2026.9.12
pkgrel=1
pkgdesc='Linux system metrics as JSON/JSONL and a terminal monitor'
arch=('x86_64')
url='https://github.com/StatIndet/keytop'
license=('GPL-3.0-or-later')
makedepends=(cmake ninja pkgconf qt6-base ncurses)
checkdepends=(python git)
source=("keytop-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/keytop-${pkgver}.tar.gz")
sha256sums=('d26157b37d66821fed6b0a69a2afef8ac17561ed0336d00a6c12a0c71c28b6c9')

build() {
    cmake -S "keytop-${pkgver}" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure --no-tests=error
    test "$(build/bin/keytop --version)" = "keytop ${pkgver}"
}

package_keytop() {
    depends=(qt6-base ncurses)
    optdepends=('keytop-privileged-access: CAP_PERFMON and CAP_DAC_READ_SEARCH access' 'nvidia-utils: NVML for installed NVIDIA drivers; do not install on other hardware')
    DESTDIR="${pkgdir}" cmake --install build
}

package_keytop-privileged-access() {
    pkgdesc='Optional CAP_PERFMON and CAP_DAC_READ_SEARCH authorization for keytop'
    arch=('any')
    depends=(keytop libcap bash coreutils pacman)
    install=keytop-privileged-access.install
    cd "keytop-${pkgver}" || return
    install -Dm755 packaging/arch/keytop-capabilities.sh "${pkgdir}/usr/lib/keytop/privileged-access"
    install -Dm644 packaging/arch/keytop-privileged-access.hook "${pkgdir}/usr/share/libalpm/hooks/keytop-privileged-access.hook"
    install -Dm644 docs/installation.md "${pkgdir}/usr/share/doc/keytop-privileged-access/installation.md"
}
