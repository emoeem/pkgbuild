pkgver() {
    cd mpv
    git describe --long --tags --always | sed -E 's/^v//; s/([^-]+)-([0-9]+)-g/\1.r\2.g/; s/-/./g'
}

prepare() {
    cd "${srcdir}/mpv"
    local patch_file
    for patch_file in "${srcdir}"/patches/*.patch; do
        [[ -f "$patch_file" ]] || continue
        patch -Np1 < "$patch_file"
    done
}

build() {
    arch-meson build \
        -Dgpl=true -Dcplayer=true -Dlibmpv=true -Dbuild-date=false \
        -Dtests=true -Dorender=enabled -Dvulkan=enabled -Dwayland=enabled \
        -Dcuda-hwaccel=enabled -Dcuda-interop=enabled \
        -Dvapoursynth=enabled -Dzimg=enabled -Dpipewire=enabled \
        -Dpulse=enabled -Dalsa=enabled -Djack=enabled \
        -Ddvdnav=enabled -Dlibbluray=enabled -Dlibavdevice=enabled \
        -Dlcms2=enabled -Drubberband=enabled -Duchardet=enabled \
        -Dlibarchive=enabled -Dx11=enabled -Dvaapi=enabled
    meson compile -C build
}
check() {
    meson test -C build --print-errorlogs
}

package() {
    meson install -C build --destdir "$pkgdir"
}
