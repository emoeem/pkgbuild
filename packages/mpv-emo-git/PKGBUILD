url='https://github.com/mpv-player/mpv'
depends=('ffmpeg' 'libass' 'libbluray' 'libplacebo' 'luajit' 'pipewire' 'vapoursynth' 'libxkbcommon' 'libxss' 'libxext' 'libxpresent' 'libxrandr' 'libxv'
         'vulkan-icd-loader' 'wayland' 'wayland-protocols' 'zimg' 'alsa-lib' 'jack2' 'libpulse' 'libpipewire' 'sndio' 'libjpeg-turbo' 'libvdpau' 'libxfixes' 'libglvnd' 'libdrm' 'hicolor-icon-theme' 'zlib-ng-compat' 'ffnvcodec-headers'
         'libva' 'libx11' 'lcms2' 'libarchive' 'libdvdnav' 'rubberband' 'uchardet')
optdepends=('orender: enable the bundled Omniphony spatial-audio decoder at runtime')
makedepends=('git' 'meson' 'vulkan-headers' 'wayland-protocols' 'ffnvcodec-headers')
provides=('mpv' 'libmpv.so=2-64')
conflicts=('mpv' 'mpv-full' 'mpv-emo')
source=('mpv::git+https://github.com/mpv-player/mpv.git#commit=0b7ed670f7c353dd3dd4f8ae0fc788a181a15aa6' *.patch)

