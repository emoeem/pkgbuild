# mpv-Emo Development — upstream master track.
# The updater pins an exact upstream commit; the package remains reproducible.

pkgname=mpv-emo-git
pkgver=0.41.0.r1049.g0b7ed670f
pkgrel=1
pkgdesc='mpv-Emo development: upstream mpv master with Linux features'
arch=('x86_64')
license=('GPL-2.0-or-later')
url='https://github.com/mpv-player/mpv'
depends=('ffmpeg' 'libass' 'libbluray' 'libplacebo' 'lua' 'pipewire' 'vapoursynth'
         'vulkan-icd-loader' 'wayland' 'zimg')
makedepends=('git' 'meson' 'vulkan-headers' 'wayland-protocols' 'ffnvcodec-headers')
provides=('mpv' 'libmpv.so=2-64')
conflicts=('mpv' 'mpv-full' 'mpv-emo' 'mpv-emo-omniphony')
source=('mpv::git+https://github.com/mpv-player/mpv.git#commit=0b7ed670f7c353dd3dd4f8ae0fc788a181a15aa6')
sha256sums=('SKIP')

pkgver() {
    cd mpv
    git describe --long --tags --always | sed -E 's/^v//; s/([^-]+)-([0-9]+)-g/\1.r\2.g/; s/-/./g'
}

build() {
    arch-meson mpv build \
        -Dgpl=true -Dcplayer=true -Dlibmpv=true -Dbuild-date=false \
        -Dtests=true -Dvulkan=enabled -Dwayland=enabled \
        -Dcuda-hwaccel=enabled -Dcuda-interop=enabled \
        -Dvapoursynth=enabled -Dzimg=enabled -Dpipewire=enabled \
        -Dpulse=enabled -Dalsa=enabled -Djack=enabled \
        -Ddvdnav=enabled -Dlibbluray=enabled -Dlibavdevice=enabled \
        -Dlcms2=enabled -Drubberband=enabled -Duchardet=enabled \
        -Dlibarchive=enabled -Dx11=enabled -Dvaapi=enabled
    meson compile -C build
}

check() {
    meson test -C build --print-errorlogs
}

package() {
    meson install -C build --destdir "$pkgdir"
}
