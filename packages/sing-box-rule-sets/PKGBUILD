# Maintainer: emoeem
#
# 补充规则集包：把审计(2026-10-02)里验证过的几份规则数据固化成「跟着 pacman 更新」的资产。
#
# 内容（装到 /usr/share/sing-box-rule-sets/）：
#   anti-ad.srs                    ← anti-AD 广告/追踪表（AdGuard 语法，构建时用 sing-box 自带转换器转 .srs）
#   geoip-cn-fresh.srs             ← MetaCubeX 最新 geoip/cn（本地 sing-geoip-rule-set 常年偏旧，实测缺段）
#   cncidr-mihomo.srs              ← HenryChiao/mihomo_yamls 的国内 IP 表（第三份独立来源）
#   adblockfilters.srs             ← 217heidai/adblockfilters 聚合广告表（215k 条域名后缀，8 小时更新）
#   lyc-geosite-cn.srs             ← lyc8503/sing-box-rules（Loyalsoldier/v2ray-rules-dat 移植）的 geosite/cn
#   lyc-geosite-geolocation-!cn.srs← 同上，geosite/geolocation-!cn
#   must-direct.srs                ← 自制：STUN/游戏主机/LAN cache/NCSI 必须直连（走代理会坏功能）
#   ads-extra.srs                  ← 自制：anti-AD 漏掉的国内广告端点（精确域名，不动 apex）
#
# 为什么单独打包：这些数据每天都在变，而 sing-geoip-rule-set / sing-geosite-rule-set 更新很慢；
# 放在这里就能跟着本仓库的 CI 一起滚动重建（见 scripts/refresh-rule-sets.sh + 定时工作流）。
#
# 数据来源与许可：
#   MetaCubeX/meta-rules-dat → GPL-3.0-or-later
#   HenryChiao/mihomo_yamls  → AGPL-3.0-or-later
#   anti-AD (prprpi/anti-AD) → 仓库未附许可证文件，个人使用；此处标注 LicenseRef-anti-AD
#   lyc8503/sing-box-rules   → 仓库未附许可证文件，数据移植自 Loyalsoldier/v2ray-rules-dat（GPL-3.0），
#                              故归入本包的 GPL-3.0-or-later；用它的理由见下方注释。
#
# 升级方式：`pkgver` 用日期；`scripts/refresh-rule-sets.sh` 每天比对上游内容
# （哈希记录在同目录 .source-hashes）并在有变化时提交 + 触发重建发布。
#
# 校验策略（2026-10-20 起）：六份远程源按"易变"处理，sha256sums 写作 SKIP。
# 原因：这些源 8 小时到每日更新一次，钉死的哈希必然在 refresh 与构建之间过期，
# 于是构建 fail-closed 失败；发布又是 all-or-nothing，一个包失败会连带 skip 掉
# 整轮发布（2026-10-12 当天 7 轮红就是这么来的）。现在改成：
#   1. 不做下载前哈希比对（SKIP），上游变了照样能构建；
#   2. 下载后在 build() 里做内容断言：非空 / SRS magic / 文本源行数下限，
#      错误页、404、截断响应依旧会被拦下；
#   3. 实际下载到的哈希写进包内 /usr/share/sing-box-rule-sets/SOURCE-HASHES.txt，
#      事后可审计"这一版到底装了什么"。
# 仍然钉死的是仓库内自制的三份文件（must-direct.json / ads-extra.json /
# LICENSE-anti-AD）——它们由本仓库控制，不该变。
# scripts/refresh-rule-sets.sh 依旧每 2 小时比对上游并记录到 .source-hashes，
# 但只用来决定"要不要 bump 版本触发重建"，不再写入 sha256sums。

pkgname=sing-box-rule-sets
pkgver=20261022
pkgrel=3
pkgdesc='Extra sing-box rule-sets: anti-AD + adblockfilters tracker lists, fresh geoip/cn, mihomo CN CIDR, Loyalsoldier enhanced geosite (cn/non-cn), always-direct list, CN ad-SDK extras'
arch=('any')
url='https://github.com/emoeem/pkgbuild'
license=('GPL-3.0-or-later' 'AGPL-3.0-or-later' 'LicenseRef-anti-AD')
# 运行时要 sing-box 来读这些规则集；构建时也要它自带的 rule-set 转换器
depends=('sing-box')
makedepends=('sing-box')
options=('!strip')
source=(
    'anti-ad.txt::https://anti-ad.net/adguard.txt'
    'geoip-cn.srs::https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/cn.srs'
    'cncidr.srs::https://raw.githubusercontent.com/HenryChiao/mihomo_yamls/ruleset/singbox/version4/cncidr.srs'
    # adblockfilters（217heidai）：聚合 EasyList / EasyPrivacy / AdGuard 全家桶 / AdRules / OISD /
    # DNS-Blocklists PRO / StevenBlack / AWAvenue …，每 8 小时更新，并会先用 3+3 组 DNS 验证
    # 上游域名是否还有效（去掉失效的）。上游**直接提供 sing-box 1.12+ 的 .srs**，无需转换。
    'adblockfilters.srs::https://raw.githubusercontent.com/217heidai/adblockfilters/main/rules/adblocksingbox.srs'
    # lyc8503/sing-box-rules：把 Loyalsoldier/v2ray-rules-dat 的地理数据移植成 sing-box .srs，日更。
    # 用它做国内分流的**补充**：官方 sing-geosite 的 cn 只有 ~8.7k 域名后缀，这份 ~11 万，
    # 国内直连判得更准（放在 geosite/cn 旁边一起匹配即可，不是替换）。上游直接给 .srs。
    'lyc-geosite-cn.srs::https://raw.githubusercontent.com/lyc8503/sing-box-rules/rule-set-geosite/geosite-cn.srs'
    'lyc-geosite-geolocation-!cn.srs::https://raw.githubusercontent.com/lyc8503/sing-box-rules/rule-set-geosite/geosite-geolocation-!cn.srs'
    'must-direct.json'
    'ads-extra.json'
    'LICENSE-anti-AD'
)
# 顺序与 source 一致：前六项是易变远程源（SKIP），后三项是仓库内自制文件（钉死）。
sha256sums=(
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'SKIP'
    'ba3a2f0b5371bdd6e5e79479215bf04da1343cb347a065dd6e722ab51aae14a8'
    '40e95f074c514a98fb3d78903e87a407a2f4780900fcbba9cda671c4f035f18a'
    '01e7be5ef36f71e2f068985983b0f9306e3a71bb0a24b06b00ae9d6a539aa46d'
)

_rule_sets=(
    anti-ad
    geoip-cn-fresh
    cncidr-mihomo
    adblockfilters
    lyc-geosite-cn
    lyc-geosite-geolocation-!cn
    must-direct
    ads-extra
)

# 上游直接下载的成品 .srs（与上面重叠，用于更严格的体量检查）
_upstream_rule_sets=(
    geoip-cn-fresh
    cncidr-mihomo
    adblockfilters
    lyc-geosite-cn
    lyc-geosite-geolocation-!cn
)

build() {
    cd "$srcdir"

    # 远程源不再做哈希比对，下载后的内容断言就成了唯一把关，这里是第一道：
    # anti-ad.txt 是文本源，404 页面 / 错误页 / 截断响应的行数远低于万行级，
    # 必须在转换之前拦下，否则会产出一个"看起来合法"的空规则集。
    local anti_ad_lines
    anti_ad_lines="$(wc -l < anti-ad.txt)"
    (( anti_ad_lines >= 10000 )) || {
        printf 'sing-box-rule-sets: anti-ad.txt 只有 %s 行，疑似错误页或截断\n' "$anti_ad_lines" >&2
        return 1
    }

    # 把这一版真正用到的上游哈希写进包里（易变源不钉死，但可事后审计）。
    {
        printf '# SHA-256 of the upstream files actually downloaded for this build.\n'
        printf '# Volatile upstreams are not pinned; this file records what shipped.\n'
        sha256sum anti-ad.txt geoip-cn.srs cncidr.srs adblockfilters.srs \
            lyc-geosite-cn.srs 'lyc-geosite-geolocation-!cn.srs'
    } > SOURCE-HASHES.txt

    # AdGuard 语法 → sing-box 二进制规则集（用的是包依赖里的 sing-box 自带转换器）
    sing-box rule-set convert anti-ad.txt -t adguard -o anti-ad.srs

    # 自制清单：源 JSON → .srs
    sing-box rule-set compile must-direct.json -o must-direct.srs
    sing-box rule-set compile ads-extra.json   -o ads-extra.srs

    # 上游直接给的 .srs 改个更明确的名字
    install -m 644 geoip-cn.srs   geoip-cn-fresh.srs
    install -m 644 cncidr.srs     cncidr-mihomo.srs
    # lyc-*.srs 已经是带 SRS magic 的成品，文件名即最终名，无需转换/改名

    # 兜底断言：全部产物都必须是合法 rule-set（magic = "SRS"）
    local f
    for f in "${_rule_sets[@]}"; do
        [[ -s "$f.srs" ]] || { printf 'sing-box-rule-sets: %s.srs 为空\n' "$f" >&2; return 1; }
        [[ "$(head -c 3 "$f.srs")" == "SRS" ]] || {
            printf 'sing-box-rule-sets: %s.srs 不是合法 rule-set\n' "$f" >&2
            return 1
        }
    done

    # 第二道：上游直接给成品 .srs 的几份，体量不能退化。空壳 .srs（只有 magic
    # 没有条目）也有几十字节，1 KiB 是极低的下限，只用来挡掉"上游返回了一个几乎
    # 空的响应"。自制的两份小表（must-direct / ads-extra）本身只有几百字节，由
    # sing-box rule-set compile 的成功与否把关，不在体积检查范围内。
    # 注意：srcdir 里的源文件是符号链接，必须 wc -c 读内容（stat -c %s 会拿到
    # 链接自身长度 72）。
    local f size
    for f in "${_upstream_rule_sets[@]}"; do
        size="$(wc -c < "$f.srs")"
        (( size >= 1024 )) || {
            printf 'sing-box-rule-sets: %s.srs 只有 %s 字节，疑似空响应\n' "$f" "$size" >&2
            return 1
        }
    done
    printf '%s\n' "Built ${#_rule_sets[@]} rule-sets:"
    # -L：srcdir 里的源文件是符号链接，不带 -L 看到的是链接自身长度（几十字节）
    ls -lL ./*.srs | awk '{print "  ",$5,$9}'
}

package() {
    install -d "$pkgdir/usr/share/sing-box-rule-sets"
    local f
    for f in "${_rule_sets[@]}"; do
        install -m 644 "$srcdir/$f.srs" "$pkgdir/usr/share/sing-box-rule-sets/$f.srs"
    done

    # 审计留痕：易变上游不钉哈希，但这一版装进去的文件哈希都记在这里
    install -m 644 "$srcdir/SOURCE-HASHES.txt" \
        "$pkgdir/usr/share/sing-box-rule-sets/SOURCE-HASHES.txt"

    # 许可证说明：namcap 要求 LicenseRef-* 必须在 /usr/share/licenses/<pkg>/ 下有对应文件
    install -Dm644 "$srcdir/LICENSE-anti-AD" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE-anti-AD"

    install -Dm644 /dev/stdin "$pkgdir/usr/share/sing-box-rule-sets/README.md" <<'EOF'
# sing-box 补充规则集

由 `sing-box-rule-sets` 包安装到本目录，随 pacman 更新。所有文件都是 sing-box 二进制规则集（`.srs`）。

| 文件 | 内容 | 用途 |
|---|---|---|
| `anti-ad.srs` | anti-AD 广告/追踪表（AdGuard 源，构建时转换） | 补 DNS/连接层的广告拦截 |
| `geoip-cn-fresh.srs` | MetaCubeX 最新 `geoip/cn` | 国内 IP 判定（比 `sing-geoip-rule-set` 新） |
| `cncidr-mihomo.srs` | mihomo_yamls 的国内 IP 表（独立来源，17958 条） | 与上面互为补充 |
| `adblockfilters.srs` | 217heidai/adblockfilters 聚合表（215248 条域名后缀，8 小时更新） | 广告/追踪拦截的国际表覆盖更广（EasyPrivacy / AdGuard 全家桶 / OISD…） |
| `lyc-geosite-cn.srs` | lyc8503/sing-box-rules 的 `geosite/cn`（~110k 域名后缀，日更） | **国内分流补充**：官方 `sing-geosite` 的 `cn` 只有 ~8.7k 后缀，这份更全，放在 `geosite/cn` 旁一起匹配 |
| `lyc-geosite-geolocation-!cn.srs` | 同上仓库的 `geosite/geolocation-!cn`（~26k 后缀，日更） | 境外域名判定补充（与官方 `geolocation-!cn` 并集） |
| `must-direct.srs` | ① STUN / 游戏主机 / LAN cache / NCSI ② **Steam 国服 CDN** | ① 走代理会坏功能（NAT 类型、Steam 局域网缓存）；② 直连明显更快 —— 只取国内 CDN 端点（`st.dl.eccdnx.com`、`dl.steam.clngaa.com`、`csgo.com.cn`…，来自 lingqiqi5211/sing-box-rules 的 `steam-cn`），**刻意不含** `steamcontent.com` / `steamusercontent.com` / `cm.steampowered.com` 等全球域名（强制直连有风险） |
| `ads-extra.srs` | `ad.duowan.com` / `sdkmob.com` / `ads.wps.cn` | 补 anti-AD 漏掉的国内广告端点（只用精确域名，不拦 apex） |

`SOURCE-HASHES.txt` 记录本版实际打包的上游文件 SHA-256。上游每天（adblockfilters 每 8 小时）
更新一次，包里不钉死哈希以免构建因"校验和过期"失败；要核实某一版装了什么，看这个文件。

## 在 sing-box 配置里引用

```jsonc
// route.rule_set
{ "type": "local", "tag": "anti-AD",     "format": "binary", "path": "/usr/share/sing-box-rule-sets/anti-ad.srs" },
{ "type": "local", "tag": "geoip/cn-fresh", "format": "binary", "path": "/usr/share/sing-box-rule-sets/geoip-cn-fresh.srs" },
{ "type": "local", "tag": "cncidr-mihomo",  "format": "binary", "path": "/usr/share/sing-box-rule-sets/cncidr-mihomo.srs" },
{ "type": "local", "tag": "must-direct",    "format": "binary", "path": "/usr/share/sing-box-rule-sets/must-direct.srs" },
{ "type": "local", "tag": "ads-extra",      "format": "binary", "path": "/usr/share/sing-box-rule-sets/ads-extra.srs" },
{ "type": "local", "tag": "adblockfilters", "format": "binary", "path": "/usr/share/sing-box-rule-sets/adblockfilters.srs" },
{ "type": "local", "tag": "lyc/cn",              "format": "binary", "path": "/usr/share/sing-box-rule-sets/lyc-geosite-cn.srs" },
{ "type": "local", "tag": "lyc/geolocation-!cn", "format": "binary", "path": "/usr/share/sing-box-rule-sets/lyc-geosite-geolocation-!cn.srs" }

// DNS 与路由的 reject 规则都要带上广告表（浏览器自带 DoH 会绕过 DNS 规则，连接层才是兜底）
{ "rule_set": ["geosite/category-ads-all", "Ads_AWAvenue", "anti-AD", "ads-extra", "adblockfilters"], "action": "reject" }

// 国内域名：官方 geosite/cn + lyc 增强表一起匹配（并集，不是替换）
{ "rule_set": ["geosite/cn", "lyc/cn"], "action": "route", "server": "dns-direct" }

// 境外域名：官方 geolocation-!cn + lyc 增强表一起匹配
{ "rule_set": ["geosite/geolocation-!cn", "lyc/geolocation-!cn"], "action": "route", "outbound": "Proxy" }

// 国内 IP：三份表一起匹配
{ "rule_set": ["geoip/cn", "geoip/cn-fresh", "cncidr-mihomo"], "action": "route", "outbound": "direct" }

// 必须直连：放在 ip_is_private 之后、广告规则之前
{ "rule_set": ["must-direct"], "action": "route", "outbound": "direct" }
```

## 许可证

- `geoip-cn-fresh.srs`：MetaCubeX/meta-rules-dat，GPL-3.0-or-later
- `cncidr-mihomo.srs`：HenryChiao/mihomo_yamls，AGPL-3.0-or-later
- `anti-ad.srs`：prprpi/anti-AD（仓库未附许可证文件，个人使用）
- `adblockfilters.srs`：217heidai/adblockfilters，GPL-3.0（聚合上游各表，上游许可见其仓库）
- `lyc-geosite-*.srs`：lyc8503/sing-box-rules（数据移植自 Loyalsoldier/v2ray-rules-dat，GPL-3.0；该仓未附许可证文件）
- `must-direct.srs` / `ads-extra.srs`：本仓库自制
EOF
}
