pkgbase = sing-box-rule-sets
	pkgdesc = Extra sing-box rule-sets: anti-AD + adblockfilters tracker lists, fresh geoip/cn, mihomo CN CIDR, Loyalsoldier enhanced geosite (cn/non-cn), always-direct list, CN ad-SDK extras
	pkgver = 20261011
	pkgrel = 1
	url = https://github.com/emoeem/pkgbuild
	arch = any
	license = GPL-3.0-or-later
	license = AGPL-3.0-or-later
	license = LicenseRef-anti-AD
	makedepends = sing-box
	depends = sing-box
	options = !strip
	source = anti-ad.txt::https://anti-ad.net/adguard.txt
