	source = lyc-geosite-cn.srs::https://raw.githubusercontent.com/lyc8503/sing-box-rules/rule-set-geosite/geosite-cn.srs
	source = lyc-geosite-geolocation-!cn.srs::https://raw.githubusercontent.com/lyc8503/sing-box-rules/rule-set-geosite/geosite-geolocation-!cn.srs
	source = must-direct.json
	source = ads-extra.json
	source = LICENSE-anti-AD
	sha256sums = SKIP
