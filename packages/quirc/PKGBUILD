# Maintainer:
# Contributor: Fabio Comuni <fabrix.xm@gmail.com>

_pkgname="quirc"
pkgname="$_pkgname"
pkgver=1.2
pkgrel=5
pkgdesc="QR decoder library"
url="https://github.com/dlbeer/quirc"
license=('ISC')
arch=('i686' 'x86_64')

depends=(
  'libjpeg-turbo'
  'sdl12-compat'
  'sdl_gfx'
)

_pkgsrc="$_pkgname-$pkgver"
_pkgext="tar.gz"
source=("$_pkgsrc.$_pkgext"::"$url/archive/v$pkgver.$_pkgext")
sha256sums=('73c12ea33d337ec38fb81218c7674f57dba7ec0570bddd5c7f7a977c0deb64c5')

build() {
  cd "$_pkgsrc"
  # Upstream's link rule is "$(CC) -shared -o $@ $(LIB_OBJ) $(LDFLAGS) -lm",
  # so the SONAME only appears if LDFLAGS carries it. Without one the loader
  # cannot resolve the library at runtime, which scripts/runtime-verify.sh
  # reports as missing-soname.
  CFLAGS+=" -fPIC" LDFLAGS+=" -Wl,-soname,libquirc.so.1" \
    make libquirc.so quirc-demo quirc-scanner
}

package() {
  cd "$_pkgsrc"
  install -Dm644 "lib/quirc.h" "$pkgdir/usr/include/quirc.h"

  # Installed under the SONAME (the conventional libquirc.so.1) instead of the
  # full upstream version: the linker records the SONAME, so a file named
  # libquirc.so.1.2 would be a name the loader never looks for.
  install -Dm755 "libquirc.so.$pkgver" "$pkgdir/usr/lib/libquirc.so.1"
  ln -s "libquirc.so.1" "$pkgdir/usr/lib/libquirc.so"

  install -Dm755 quirc-demo -t "$pkgdir/usr/bin/"
  install -Dm755 quirc-scanner -t "$pkgdir/usr/bin/"

  install -Dm644 "LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
