class Subscriptions:
    def __init__(self, settings: Settings, configs: ConfigManager):
        self.s = settings
        self.configs = configs
        # The HTTP server is threaded and the scheduler runs in its own thread;
        # serialize subscriptions.json read/modify/write cycles.
        self.lock = threading.RLock()

    # 抓取 -------------------------------------------------------------------
    def fetch(self, url: str) -> tuple[bool, str, dict]:
        if urllib.parse.urlparse(url).scheme not in ("http", "https"):
            return False, "订阅 URL 只支持 http/https", {}
        proxy = self.s.get("subscription_proxy") or ""
        handlers = []
        if proxy:
            handlers.append(urllib.request.ProxyHandler({"http": proxy, "https": proxy}))
        opener = urllib.request.build_opener(*handlers)
        req = urllib.request.Request(url, headers={"User-Agent": "sing-box-panel/" + VERSION})
        try:
            with opener.open(req, timeout=45) as resp:
                text = resp.read().decode("utf-8", "replace")
                userinfo = parse_userinfo(resp.headers.get("Subscription-Userinfo", ""))
                return True, text, userinfo
        except Exception as exc:  # noqa: BLE001
            return False, str(exc), {}

    # 列表操作 ---------------------------------------------------------------
    def list(self) -> list:
        with self.lock:
            subs = self.s.subscriptions()
            for sub in subs:
                sub["node_count"] = len(sub.get("nodes", []))
                sub.pop("nodes", None)
                sub["enabled"] = bool(sub.get("enabled", True))
                interval = normalize_update_interval(sub.get("update_interval", 0))
                sub["update_interval"] = interval
                last_attempt = int(sub.get("last_attempt") or sub.get("last_update") or 0)
                sub["last_attempt"] = last_attempt
                sub["next_update"] = (
                    last_attempt + interval if sub["enabled"] and interval > 0 else 0
                )
                info = sub.get("userinfo")
                if isinstance(info, dict):
                    sub["userinfo"] = {
                        key: value
                        for key, value in info.items()
                        if key in ("upload", "download", "total", "expire")
                        and isinstance(value, int)
                    }
                else:
                    sub["userinfo"] = {}
            return subs

    def add(self, name: str, url: str, enabled: bool = True, update_interval=None) -> dict:
        interval = normalize_update_interval(
            self.s.get("subscription_update_interval", 0)
            if update_interval is None
            else update_interval
        )
        host = urllib.parse.urlparse(url).netloc or "订阅"
        sub = {
            "id": secrets.token_hex(4),
            "name": name or host,
            "url": url,
            "enabled": enabled,
            "update_interval": interval,
            "last_update": 0,
            "last_attempt": 0,
            "last_error": "",
            "userinfo": {},
            "nodes": [],
        }
        with self.lock:
            subs = self.s.subscriptions()
            subs.append(sub)
            self.s.write_json(self.s.subs_file, subs)
        return self.update(sub["id"])

    def remove(self, sub_id: str) -> dict:
        with self.lock:
            subs = [x for x in self.s.subscriptions() if x.get("id") != sub_id]
            self.s.write_json(self.s.subs_file, subs)
        return ok("已删除订阅")

    def update(self, sub_id: str) -> dict:
        # Fetch outside the lock so a slow subscription does not block the UI.
        with self.lock:
            target = next((x for x in self.s.subscriptions() if x.get("id") == sub_id), None)
            if not target:
                return err("找不到该订阅")
            url = target["url"]

        okc, text, userinfo = self.fetch(url)

        with self.lock:
            subs = self.s.subscriptions()
            target = next((x for x in subs if x.get("id") == sub_id), None)
            if not target:
                return err("找不到该订阅")
            target["last_attempt"] = int(time.time())
            if not okc:
                target["last_error"] = text
                self.s.write_json(self.s.subs_file, subs)
                return err(f"下载失败：{text}")
            nodes, skipped = parse_subscription(text)
            target["nodes"] = nodes
            target["last_update"] = int(time.time())
            target["last_error"] = "" if nodes else "未解析出任何节点"
            target["userinfo"] = userinfo
            self.s.write_json(self.s.subs_file, subs)

        msg = f"更新成功：{len(nodes)} 个节点"
        if skipped:
            msg += f"，{len(skipped)} 个暂不支持（{'、'.join(sorted(set(skipped))[:6])}…）"
        return {"ok": bool(nodes), "message": msg, "nodes": len(nodes), "skipped": sorted(set(skipped))}

    def update_all(self) -> dict:
        results = []
        for sub in self.list():
            if sub.get("enabled"):
                results.append({"name": sub["name"], **self.update(sub["id"])})
        return {"ok": all(r.get("ok") for r in results) if results else False, "results": results}

    def configure(self, sub_id: str, update_interval=None, enabled=None) -> dict:
        with self.lock:
            subs = self.s.subscriptions()
            target = next((x for x in subs if x.get("id") == sub_id), None)
            if not target:
                return err("找不到该订阅")
            if update_interval is not None:
                target["update_interval"] = normalize_update_interval(update_interval)
            if enabled is not None:
                if isinstance(enabled, str):
                    enabled = enabled.lower() in ("1", "true", "yes", "on")
                target["enabled"] = bool(enabled)
            self.s.write_json(self.s.subs_file, subs)
            interval = normalize_update_interval(target.get("update_interval", 0))
            active = interval > 0 and bool(target.get("enabled", True))
        return ok("自动更新设置已保存" if active else "自动更新已关闭")

    def run_due(self) -> None:
        now = int(time.time())
        for sub in self.list():
            interval = int(sub.get("update_interval") or 0)
            if not sub.get("enabled") or interval <= 0:
                continue
            next_update = int(sub.get("next_update") or 0)
            if next_update <= now:
                log(f"自动更新订阅：{sub.get('name') or sub['id']}")
                self.update(sub["id"])

    # 写入配置 ---------------------------------------------------------------
    def apply(self) -> dict:
        with self.lock:
            subs = [x for x in self.s.subscriptions() if x.get("enabled")]
            cfg = self.s.load_sing_box_config()
            managed = self.s.managed()
            old_tags = set(managed.get("outbound_tags", []))

            outbounds = [o for o in cfg.get("outbounds", []) if o.get("tag") not in old_tags]
            new_tags: list[str] = []
            per_sub: dict[str, list[str]] = {}

            existing = {o.get("tag") for o in outbounds}
            for sub in subs:
                tags = []
                for node in sub.get("nodes", []):
                    tag = str(node.get("tag", "")).strip() or "node"
                    base = tag
                    i = 2
                    while tag in existing or tag in new_tags:
                        tag = f"{base} #{i}"
                        i += 1
                    node = dict(node)
                    node["tag"] = tag
                    outbounds.append(node)
                    new_tags.append(tag)
                    tags.append(tag)
                per_sub[sub["id"]] = tags

            # 组：默认托管 Proxy（selector）与 Auto（urltest），另外每个订阅各建一组
            members_map: dict[str, list[str]] = {}
            group_tag = self.s.get("managed_group") or ""
            if group_tag and new_tags:
                members_map[group_tag] = new_tags
            urltest_tag = self.s.get("managed_urltest") or ""
            if urltest_tag and new_tags:
                members_map[urltest_tag] = new_tags

            by_tag = {o.get("tag"): o for o in outbounds}
            for tag, members in members_map.items():
                node = by_tag.get(tag)
                if node is None:
                    continue
                previous = set(managed.get("group_members", {}).get(tag, []))
                kept = [m for m in node.get("outbounds", []) if m not in previous]
                node["outbounds"] = kept + members

            cfg["outbounds"] = outbounds
            result = self.configs.apply(cfg, "subscriptions-apply")
            if result.get("ok"):
                self.s.write_json(
                    self.s.managed_file,
                    {
                        "outbound_tags": new_tags,
                        "group_members": members_map,
                        "updated": int(time.time()),
                        "by_subscription": per_sub,
                    },
                )
            return result


class SubscriptionScheduler:
    """Background checker for per-subscription update intervals."""

    def __init__(self, settings: Settings, subs: Subscriptions):
        self.s = settings
        self.subs = subs

    def start(self) -> None:
        if self.s.dry_run:
            return
        threading.Thread(target=self._loop, name="subscription-scheduler", daemon=True).start()

    def _loop(self) -> None:
        try:
            tick = max(5.0, float(self.s.get("subscription_scheduler_tick", 30)))
        except (TypeError, ValueError):
            tick = 30.0
        while True:
            try:
                self.subs.run_due()
            except Exception as exc:  # noqa: BLE001
                log(f"订阅自动更新出错：{exc!r}")
            time.sleep(tick)


# --------------------------------------------------------------------------- 订阅解析


def b64decode_safe(text: str) -> str:
    text = text.strip().replace("-", "+").replace("_", "/")
    text += "=" * (-len(text) % 4)
    try:
        return base64.b64decode(text).decode("utf-8", "replace")
    except (binascii.Error, ValueError):
        return ""


def parse_subscription(text: str) -> tuple[list[dict], list[str]]:
    """返回 (outbounds, 跳过的类型)。支持 base64 链接列表、纯链接列表、Clash YAML。"""
    text = text.strip()
    if not text:
        return [], []
    head = text.lstrip()
    if head.startswith("proxies:") or "\nproxies:" in head[:2000]:
        return parse_clash_yaml(text)
    decoded = b64decode_safe(text) if "://" not in text.split("\n", 1)[0] else ""
    if decoded and "://" in decoded:
        text = decoded
    nodes, skipped = [], []
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        node, kind = parse_link(line)
        if node:
            nodes.append(node)
        elif kind:
            skipped.append(kind)
    return nodes, skipped


def parse_link(link: str) -> tuple[dict | None, str]:
    scheme = link.split("://", 1)[0].lower() if "://" in link else ""
    handlers = {
        "ss": parse_ss,
        "vmess": parse_vmess,
        "vless": parse_vless,
        "trojan": parse_trojan,
        "hysteria2": parse_hysteria2,
        "hy2": parse_hysteria2,
        "tuic": parse_tuic,
    }
    handler = handlers.get(scheme)
    if not handler:
        return None, scheme or "unknown"
    try:
        return handler(link), ""
    except Exception:  # noqa: BLE001
        return None, scheme


def _split_tag(link: str) -> tuple[str, str]:
    if "#" in link:
        body, frag = link.split("#", 1)
        return body, urllib.parse.unquote(frag)
    return link, ""


def _transport(query: dict) -> dict | None:
    net = (query.get("type") or query.get("net") or "tcp").lower()
    if net in ("ws", "websocket"):
        opts = {"type": "ws", "path": query.get("path", "/")}
        host = query.get("host") or query.get("sni")
        if host:
            opts["headers"] = {"Host": host}
        return opts
    if net == "grpc":
        return {"type": "grpc", "service_name": query.get("serviceName") or query.get("servicename") or ""}
    if net in ("http", "h2"):
        return {"type": "http", "host": [query["host"]] if query.get("host") else []}
    return None


def _tls(query: dict, server: str, force: bool = False) -> dict | None:
    security = (query.get("security") or "").lower()
    if not security and (
        force
        or query.get("sni")
        or query.get("peer")
        or query.get("tls") in ("1", "true")
        or query.get("allowInsecure") in ("1", "true")
        or query.get("insecure") in ("1", "true")
    ):
        security = "tls"
    if security not in ("tls", "reality", "xtls"):
        return None
    tls: dict = {"enabled": True, "server_name": query.get("sni") or query.get("peer") or server}
    if query.get("fp") or query.get("fingerprint"):
        tls["utls"] = {"enabled": True, "fingerprint": query.get("fp") or query.get("fingerprint")}
    if query.get("alpn"):
        tls["alpn"] = [a for a in query["alpn"].split(",") if a]
    if query.get("allowInsecure") in ("1", "true") or query.get("insecure") in ("1", "true"):
        tls["insecure"] = True
    if security == "reality":
        tls["reality"] = {
            "enabled": True,
            "public_key": query.get("pbk", ""),
            "short_id": query.get("sid", ""),
        }
    return tls


def parse_ss(link: str) -> dict:
    body, tag = _split_tag(link)
    rest = body[len("ss://"):]
    query: dict = {}
    if "?" in rest:
        rest, qs = rest.split("?", 1)
        query = dict(urllib.parse.parse_qsl(qs))
    if "@" in rest:
        userinfo, hostport = rest.rsplit("@", 1)
        creds = b64decode_safe(userinfo) or urllib.parse.unquote(userinfo)
    else:
        decoded = b64decode_safe(rest)
        if "@" not in decoded:
            raise ValueError("bad ss link")
        creds, hostport = decoded.rsplit("@", 1)
    method, _, password = creds.partition(":")
    host, _, port = hostport.rpartition(":")
    node = {
        "type": "shadowsocks",
        "tag": tag or f"{host}:{port}",
        "server": host.strip("[]"),
        "server_port": int(port),
        "method": method,
        "password": password,
    }
    plugin = query.get("plugin", "")
    if plugin:
        name, _, opts = plugin.partition(";")
        node["plugin"] = name
        if opts:
            node["plugin_opts"] = opts
    return node


def parse_vmess(link: str) -> dict:
    raw = link[len("vmess://"):]
    data = json.loads(b64decode_safe(raw.split("#", 1)[0]) or "{}")
    if not data:
        raise ValueError("bad vmess")
    node = {
        "type": "vmess",
        "tag": data.get("ps") or f"{data.get('add')}:{data.get('port')}",
        "server": data.get("add"),
        "server_port": int(data.get("port", 443)),
        "uuid": data.get("id"),
        "security": data.get("scy") or "auto",
        "alter_id": int(data.get("aid", 0) or 0),
    }
    tls = (data.get("tls") or "").lower() == "tls"
    if tls:
        node["tls"] = {"enabled": True, "server_name": data.get("sni") or data.get("host") or data.get("add")}
    net = (data.get("net") or "tcp").lower()
    if net == "ws":
        node["transport"] = {"type": "ws", "path": data.get("path", "/")}
        if data.get("host"):
            node["transport"]["headers"] = {"Host": data["host"]}
    elif net == "grpc":
        node["transport"] = {"type": "grpc", "service_name": data.get("path", "")}
    return node


def _url_node(link: str, scheme: str) -> tuple[str, str, int, str, dict]:
    body, tag = _split_tag(link)
    rest = body[len(scheme) + 3:]
    query: dict = {}
    if "?" in rest:
        rest, qs = rest.split("?", 1)
        query = dict(urllib.parse.parse_qsl(qs))
    userinfo, _, hostport = rest.rpartition("@")
    host, _, port = hostport.rpartition(":")
    return urllib.parse.unquote(userinfo), host.strip("[]"), int(port), tag, query


def parse_vless(link: str) -> dict:
    uuid, host, port, tag, query = _url_node(link, "vless")
    node = {"type": "vless", "tag": tag or f"{host}:{port}", "server": host, "server_port": port, "uuid": uuid}
    if query.get("flow"):
        node["flow"] = query["flow"]
    if query.get("encryption") and query["encryption"] != "none":
        node["encryption"] = query["encryption"]
    tls = _tls(query, host)
    if tls:
        node["tls"] = tls
    transport = _transport(query)
    if transport:
        node["transport"] = transport
    return node


def parse_trojan(link: str) -> dict:
    password, host, port, tag, query = _url_node(link, "trojan")
    node = {"type": "trojan", "tag": tag or f"{host}:{port}", "server": host, "server_port": port, "password": password}
    tls = _tls(query, host, force=True) or {"enabled": True, "server_name": host}
    node["tls"] = tls
    transport = _transport(query)
    if transport:
        node["transport"] = transport
    return node


def parse_hysteria2(link: str) -> dict:
    scheme = "hysteria2" if link.startswith("hysteria2://") else "hy2"
    password, host, port, tag, query = _url_node(link, scheme)
    node = {
        "type": "hysteria2",
        "tag": tag or f"{host}:{port}",
        "server": host,
        "server_port": port,
        "password": password or query.get("password", ""),
    }
    tls = {"enabled": True, "server_name": query.get("sni") or host}
    if query.get("insecure") in ("1", "true"):
        tls["insecure"] = True
    node["tls"] = tls
    if query.get("obfs"):
        node["obfs"] = {"type": query["obfs"], "password": query.get("obfs-password", "")}
    return node


def parse_tuic(link: str) -> dict:
    userinfo, host, port, tag, query = _url_node(link, "tuic")
    uuid, _, password = userinfo.partition(":")
    node = {
        "type": "tuic",
        "tag": tag or f"{host}:{port}",
        "server": host,
        "server_port": port,
        "uuid": uuid,
        "password": password,
    }
    tls = {"enabled": True, "server_name": query.get("sni") or host}
    if query.get("alpn"):
        tls["alpn"] = [a for a in query["alpn"].split(",") if a]
    if query.get("allow_insecure") in ("1", "true"):
        tls["insecure"] = True
    node["tls"] = tls
    if query.get("congestion_control"):
        node["congestion_control"] = query["congestion_control"]
    return node


CLASH_TYPE_MAP = {
    "ss": "shadowsocks",
    "shadowsocks": "shadowsocks",
    "vmess": "vmess",
    "vless": "vless",
    "trojan": "trojan",
    "hysteria2": "hysteria2",
    "tuic": "tuic",
}


def parse_clash_yaml(text: str) -> tuple[list[dict], list[str]]:
    nodes, skipped = [], []
    proxies = []
    if yaml is not None:
        try:
            data = yaml.safe_load(text) or {}
            proxies = data.get("proxies") or []
        except Exception:  # noqa: BLE001
            proxies = []
    if not proxies:  # 内置极简解析：只认 proxies 下的 "- {…}" / "- key: value" 块
        proxies = _minimal_yaml_proxies(text)
    for item in proxies:
        if not isinstance(item, dict):
            continue
        kind = str(item.get("type", "")).lower()
        target = CLASH_TYPE_MAP.get(kind)
        if not target:
            skipped.append(kind or "unknown")
            continue
        node = _clash_to_outbound(target, item)
        if node:
            nodes.append(node)
        else:
            skipped.append(kind)
    return nodes, skipped


def _minimal_yaml_proxies(text: str) -> list[dict]:
    """不依赖 pyyaml 的兜底：解析 `proxies:` 下形如 `- {k: v, ...}` 或 `- k: v` 的块。"""
    out: list[dict] = []
    in_proxies = False
    current: dict | None = None
    for line in text.splitlines():
        if re.match(r"^proxies:\s*$", line):
            in_proxies = True
            continue
        if not in_proxies:
            continue
        if re.match(r"^\S", line):
            break
        stripped = line.strip()
        if stripped.startswith("- "):
            current = {}
            out.append(current)
            stripped = stripped[2:]
            if stripped.startswith("{"):
                for k, v in re.findall(r"([\w-]+):\s*([^,}]+)", stripped):
                    current[k] = v.strip().strip("'\"")
                current = None
                continue
        if current is None:
            continue
        m = re.match(r"([\w-]+):\s*(.*)$", stripped)
        if m:
            current[m.group(1)] = m.group(2).strip().strip("'\"")
    return out


def _clash_to_outbound(kind: str, item: dict) -> dict | None:
    try:
        host = str(item["server"])
        port = int(item["port"])
    except (KeyError, TypeError, ValueError):
        return None
    node: dict = {"type": kind, "tag": str(item.get("name") or f"{host}:{port}"), "server": host, "server_port": port}
    tls: dict = {}
    if kind == "shadowsocks":
        node["method"] = item.get("cipher", "aes-128-gcm")
        node["password"] = item.get("password", "")
        if item.get("plugin"):
            node["plugin"] = item["plugin"]
            node["plugin_opts"] = item.get("plugin-opts") or item.get("plugin_opts") or ""
    elif kind == "vmess":
        node["uuid"] = item.get("uuid", "")
        node["security"] = item.get("cipher", "auto")
        node["alter_id"] = int(item.get("alterId", 0) or 0)
    elif kind == "vless":
        node["uuid"] = item.get("uuid", "")
        node["flow"] = item.get("flow", "")
    elif kind == "trojan":
        node["password"] = item.get("password", "")
    elif kind == "hysteria2":
        node["password"] = item.get("password", "")
    elif kind == "tuic":
        node["uuid"] = item.get("uuid", "")
        node["password"] = item.get("password", "")
        node["congestion_control"] = item.get("congestion-controller") or "bbr"

    if item.get("tls") or kind in ("trojan", "hysteria2", "tuic"):
        tls["enabled"] = True
        tls["server_name"] = item.get("sni") or item.get("servername") or host
        if str(item.get("skip-cert-verify", "")).lower() in ("true", "1"):
            tls["insecure"] = True
        if item.get("alpn"):
            alpn = item["alpn"]
            tls["alpn"] = alpn if isinstance(alpn, list) else [a for a in str(alpn).split(",") if a]
        if item.get("client-fingerprint"):
            tls["utls"] = {"enabled": True, "fingerprint": item["client-fingerprint"]}
        if item.get("reality-opts"):
            ro = item["reality-opts"] or {}
            tls["reality"] = {"enabled": True, "public_key": ro.get("public-key", ""), "short_id": ro.get("short-id", "")}
        node["tls"] = tls

    network = str(item.get("network", "tcp")).lower()
    if network == "ws":
        opts = item.get("ws-opts") or {}
        node["transport"] = {"type": "ws", "path": opts.get("path", "/")}
        headers = opts.get("headers") or {}
        if headers:
            node["transport"]["headers"] = {str(k): str(v) for k, v in headers.items()}
    elif network == "grpc":
        opts = item.get("grpc-opts") or {}
        node["transport"] = {"type": "grpc", "service_name": opts.get("grpc-service-name", "")}
    return node


# --------------------------------------------------------------------------- 分应用（UID）


def list_apps(settings: Settings) -> list[dict]:
    """把 .desktop 条目与 /proc 里跑着的进程按 UID 聚合。"""
    apps: dict[int, dict] = {}

    def ensure(uid: int) -> dict:
        return apps.setdefault(uid, {"uid": uid, "names": [], "execs": [], "pids": [], "icon": ""})

    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            uid = proc.stat().st_uid
            cmdline = (proc / "cmdline").read_bytes().split(b"\0")
            exe = os.path.basename((proc / "exe").resolve().name) if (proc / "exe").exists() else ""
        except (OSError, PermissionError):
            continue
        entry = ensure(uid)
        entry["pids"].append(int(proc.name))
        first = cmdline[0].decode("utf-8", "replace") if cmdline and cmdline[0] else exe
        if first:
            entry["execs"].append(os.path.basename(first))

    for desktop in list(Path("/usr/share/applications").glob("*.desktop")) + list(
        Path("/usr/local/share/applications").glob("*.desktop")
    ):
        try:
            text = desktop.read_text("utf-8", "replace")
        except OSError:
            continue
        name = exec_line = icon = ""
        for line in text.splitlines():
            if line.startswith("Name=") and not name:
                name = line[5:].strip()
            elif line.startswith("Exec=") and not exec_line:
                exec_line = line[5:].strip()
            elif line.startswith("Icon=") and not icon:
                icon = line[7:].strip()
        binary = re.split(r"\s+", re.sub(r"%[a-zA-Z]", "", exec_line))[0] if exec_line else ""
        binary = os.path.basename(binary)
        if not binary:
            continue
        for uid, entry in apps.items():
            if binary in entry["execs"] or any(binary in e for e in entry["execs"]):
                if name and name not in entry["names"]:
                    entry["names"].append(name)
                entry["icon"] = entry["icon"] or icon

    result = []
    for uid, entry in apps.items():
        entry["execs"] = sorted(set(entry["execs"]))[:6]
        entry["pids"] = sorted(set(entry["pids"]))[:30]
        entry["label"] = " / ".join(entry["names"]) if entry["names"] else (entry["execs"][0] if entry["execs"] else f"UID {uid}")
        result.append(entry)
    return sorted(result, key=lambda x: (x["uid"], x["label"]))


# --------------------------------------------------------------------------- HTTP


class Handler(BaseHTTPRequestHandler):
    server_version = f"sing-box-panel/{VERSION}"
    settings: Settings
    service: Service
    configs: ConfigManager
    ebpf: Ebpf
    clash: Clash
    subs: Subscriptions

    # --- 基础 ---------------------------------------------------------------
    def log_message(self, fmt: str, *args) -> None:  # 静音默认访问日志
        pass

    def _send(self, code: int, body: bytes, ctype: str = "application/json; charset=utf-8") -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def _json(self, obj, code: int = 200) -> None:
        self._send(code, json.dumps(obj, ensure_ascii=False).encode("utf-8"))

    def _download_backup(self, name: str) -> None:
        """Send a backup as an attachment after checking it is in the backup list."""
        if name not in {item["name"] for item in self.configs.list_backups()}:
            return self._json(err("找不到备份"), 404)
        base = self.configs.backup_dir().resolve()
        path = (base / name).resolve()
        try:
            path.relative_to(base)
        except ValueError:
            return self._json(err("非法备份路径"), 400)
        try:
            body = path.read_bytes()
        except OSError as exc:
            return self._json(err(f"读取备份失败：{exc}"), 500)
        self.send_response(200)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Content-Disposition", f'attachment; filename="{name}"')
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(body)

    def _body(self) -> dict:
        length = int(self.headers.get("Content-Length") or 0)
        if not length:
            return {}
        try:
            return json.loads(self.rfile.read(length).decode("utf-8"))
        except ValueError:
            return {}

    def _authorized(self) -> bool:
        supplied = self.headers.get("X-Panel-Token") or ""
        if not supplied:
            cookie = self.headers.get("Cookie") or ""
            for part in cookie.split(";"):
                k, _, v = part.strip().partition("=")
                if k == "panel_token":
                    supplied = v
        expected = self.settings.token()          # 必须先调用：首次启动时它会创建令牌文件
        return bool(supplied) and secrets.compare_digest(supplied, expected)

    # --- 路由 ---------------------------------------------------------------
    def do_GET(self) -> None:  # noqa: N802
        self._route("GET")

    def do_POST(self) -> None:  # noqa: N802
        self._route("POST")

    def do_PUT(self) -> None:  # noqa: N802
        self._route("PUT")

    def do_DELETE(self) -> None:  # noqa: N802
        self._route("DELETE")

    def _route(self, method: str) -> None:
        parsed = urllib.parse.urlparse(self.path)
        path = urllib.parse.unquote(parsed.path)
        query = dict(urllib.parse.parse_qsl(parsed.query))

        if not path.startswith("/api/"):
            return self._static(path)

        if path == "/api/ping":
            return self._json({"ok": True, "version": VERSION, "auth_required": True})
        if not self._authorized():
            return self._json({"ok": False, "message": "未授权：请在面板里填入访问令牌", "auth": False}, 401)

        if path.startswith("/api/config/backups/") and method == "GET":
            return self._download_backup(path[len("/api/config/backups/"):])

        if path == "/api/geoip" and method == "GET":
            try:
                body, status = self.geoip.lookup(str(query.get("ip", "")))
            except Exception:  # noqa: BLE001
                # Never include the queried address in logs.
                log("GeoIP 查询出错（地址不记录）")
                body, status = err("geoip database unavailable"), 503
            return self._json(body, status)

        try:
            result = self._api(method, path, query)
        except Exception as exc:  # noqa: BLE001
            log(f"API {method} {path} 出错：{exc!r}")
            return self._json({"ok": False, "message": f"内部错误：{exc}"}, 500)
        if result is None:
            return self._json({"ok": False, "message": f"未知接口：{method} {path}"}, 404)
        return self._json(result)

    def _api(self, method: str, path: str, query: dict):
        s = self.settings
        # 状态
        if path == "/api/state" and method == "GET":
            cfg = None
            cfg_error = ""
            try:
                cfg = s.load_sing_box_config()
            except Exception as exc:  # noqa: BLE001
                cfg_error = str(exc)
            inbounds = [i.get("type") for i in (cfg or {}).get("inbounds", [])]
            mode = "ebpf" if "ebpf" in inbounds else ("tun" if "tun" in inbounds else "mixed")
            st = s.sing_box_config.stat() if s.sing_box_config.exists() else None
            if s.dry_run:
                version = f"{VERSION} (dry-run)"
            else:
                rc, out, _ = run([s["sing_box_bin"], "version"], timeout=10)
                version = out.splitlines()[0].replace("sing-box version ", "").strip() if rc == 0 and out else ""

            api_service = next(
                (
                    service
                    for service in (cfg or {}).get("services", [])
                    if isinstance(service, dict) and service.get("type") == "api"
                ),
                None,
            )
            dashboard = (api_service or {}).get("dashboard")
            if isinstance(dashboard, bool):
                official_dashboard_available = dashboard
            elif isinstance(dashboard, dict):
                official_dashboard_available = bool(dashboard.get("enabled", True))
            elif isinstance(dashboard, str):
                official_dashboard_available = dashboard != ""
            else:
                official_dashboard_available = api_service is not None
            official_url = (
                s.get("official_dashboard_url", "http://127.0.0.1:9091/dashboard/")
                if official_dashboard_available
                else ""
            )
            zashboard_available = (Path(s["zashboard_dir"]) / "index.html").is_file()

            return {
                "ok": True,
                "version": version,
                "panel_version": VERSION,
                "mode": mode,
                "inbounds": inbounds,
                "service": self.service.status(),
                "config_path": str(s.sing_box_config),
                "config_mtime": int(st.st_mtime) if st else 0,
                "config_bytes": st.st_size if st else 0,
                "config_error": cfg_error,
                "dry_run": s.dry_run,
                "clash_api": s["clash_api"],
                "clash_secret": s.clash_secret(),
                "zash_setup_url": _zash_setup_url(s),
                "zashboard_available": zashboard_available,
                "official_dashboard_url": official_url,
                "official_dashboard_available": official_dashboard_available,
                "metacubexd_url": _metacubexd_url(s, cfg),
                "managed_group": s.get("managed_group"),
                "managed_urltest": s.get("managed_urltest"),
                "egress_ip": s.egress_ip(),
                "token_file": str(s.token_file),
            }

        if path == "/api/service" and method == "POST":
            return self.service.control(str(self._body().get("action", "")))

        if path == "/api/logs" and method == "GET":
            return {"ok": True, "lines": self.service.journal(int(query.get("n", 200)))}

        # 配置
        if path == "/api/config" and method == "GET":
            return {
                "ok": True,
                "path": str(s.sing_box_config),
                "text": s.sing_box_config.read_text("utf-8") if s.sing_box_config.exists() else "",
                "backups": self.configs.list_backups(),
            }
        if path == "/api/config" and method == "POST":
            body = self._body()
            try:
                cfg = loads_config(body.get("text", ""))
            except ValueError as exc:
                return err(f"JSON 语法错误：{exc}")
            return self.configs.apply(cfg, "manual-edit")
        if path == "/api/config/validate" and method == "POST":
            try:
                cfg = loads_config(self._body().get("text", ""))
            except ValueError as exc:
                return err(f"JSON 语法错误：{exc}")
            okc, msg = self.configs.check(cfg)
            return {"ok": okc, "message": msg}
        if path == "/api/config/backup" and method == "POST":
            name = self.configs.backup("manual")
            return ok(f"已备份为 {name}") if name else err("线上配置不存在")
        if path == "/api/config/restore" and method == "POST":
            return self.configs.restore(str(self._body().get("name", "")))

        # eBPF
        if path == "/api/ebpf/policy" and method == "GET":
            return {"ok": True, **self.ebpf.policy()}
        if path == "/api/ebpf/policy" and method == "POST":
            body = self._body()
            return self.ebpf.set_policy(str(body.get("mode", "off")), list(body.get("uids", [])))
        if path == "/api/ebpf/probe" and method == "POST":
            return {"ok": True, "data": self.ebpf.probe(self._body().get("interface") or None)}

        # 应用列表
        if path == "/api/apps" and method == "GET":
            return {"ok": True, "apps": list_apps(s)}

        # Clash API 透传
        if path == "/api/clash/proxies" and method == "GET":
            return self.clash.proxies()
        if path == "/api/clash/connections" and method == "GET":
            return self.clash.connections()
        if path == "/api/clash/version" and method == "GET":
            return self.clash.version()
        m = re.fullmatch(r"/api/clash/proxies/(.+)/delay", path)
        if m and method == "GET":
            return self.clash.delay(
                m.group(1), query.get("url", "http://www.gstatic.com/generate_204"), int(query.get("timeout", 5000))
            )
        m = re.fullmatch(r"/api/clash/proxies/(.+)", path)
        if m and method == "PUT":
            return self.clash.select(m.group(1), str(self._body().get("name", "")))

        # 订阅
        if path == "/api/subscriptions/managed" and method == "GET":
            managed = s.managed()
            return {
                "ok": True,
                "outbound_tags": list(managed.get("outbound_tags", []) or []),
                "group_members": managed.get("group_members", {}) or {},
                "updated": managed.get("updated", 0),
                "by_subscription": managed.get("by_subscription", {}) or {},
                "managed_group": s.get("managed_group"),
                "managed_urltest": s.get("managed_urltest"),
            }
        if path == "/api/subscriptions" and method == "GET":
            return {"ok": True, "subscriptions": self.subs.list()}
        if path == "/api/subscriptions" and method == "POST":
            body = self._body()
            return self.subs.add(
                str(body.get("name", "")),
                str(body.get("url", "")),
                bool(body.get("enabled", True)),
                body.get("update_interval"),
            )
        if path == "/api/subscriptions/update_all" and method == "POST":
            return self.subs.update_all()
        if path == "/api/subscriptions/apply" and method == "POST":
            return self.subs.apply()
        m = re.fullmatch(r"/api/subscriptions/([0-9a-f]+)/schedule", path)
        if m and method == "POST":
            body = self._body()
            return self.subs.configure(
                m.group(1), body.get("update_interval"), body.get("enabled")
            )
        m = re.fullmatch(r"/api/subscriptions/([0-9a-f]+)/update", path)
        if m and method == "POST":
            return self.subs.update(m.group(1))
        m = re.fullmatch(r"/api/subscriptions/([0-9a-f]+)", path)
        if m and method == "DELETE":
            return self.subs.remove(m.group(1))
        return None

    # --- 静态文件 -----------------------------------------------------------
    def _static(self, path: str) -> None:
        if path == "/dash":
            self.send_response(302)
            self.send_header("Location", "/dash/")
            self.end_headers()
            return
        if path.startswith("/dash/"):
            base = Path(self.settings["zashboard_dir"])
            rel = path[len("/dash/"):] or "index.html"
            return self._serve(base, rel, spa=True)
        base = Path(self.settings["ui_dir"])
        rel = path.lstrip("/") or "index.html"
        if rel.startswith("ui/"):
            rel = rel[3:]
        return self._serve(base, rel, spa=False)

    def _serve(self, base: Path, rel: str, spa: bool) -> None:
        target = (base / rel).resolve()
        try:
            target.relative_to(base.resolve())
        except ValueError:
            return self._send(403, b"forbidden", "text/plain")
        if not target.is_file():
            if spa:
                target = base / "index.html"
            if not target.is_file():
                return self._send(404, b"not found", "text/plain")
        ctype = {
            ".html": "text/html; charset=utf-8",
            ".js": "application/javascript; charset=utf-8",
            ".mjs": "application/javascript; charset=utf-8",
            ".css": "text/css; charset=utf-8",
            ".json": "application/json; charset=utf-8",
            ".svg": "image/svg+xml",
            ".png": "image/png",
            ".ico": "image/x-icon",
            ".webmanifest": "application/manifest+json",
            ".jpg": "image/jpeg",
            ".woff2": "font/woff2",
            ".txt": "text/plain; charset=utf-8",
            ".md": "text/plain; charset=utf-8",
        }.get(target.suffix, "application/octet-stream")
        self._send(200, target.read_bytes(), ctype)


def _zash_setup_url(settings: Settings) -> str:
    """zashboard 的 #/setup 深链：带上主机/端口/密钥，点开即完成配置。"""
    parsed = urllib.parse.urlparse(settings["clash_api"])
    host = parsed.hostname or "127.0.0.1"
    port = parsed.port or 9090
    query = urllib.parse.urlencode({
        "hostname": host,
        "port": port,
        "secret": settings.clash_secret(),
        "protocol": parsed.scheme or "http",
    })
    return f"/dash/#/setup?{query}"



def _metacubexd_url(settings: Settings, cfg: dict | None) -> str:
    """只有当 sing-box 配置里启用 external_ui 时才返回 MetaCubeXD 入口（由 sing-box 在 9090/ui/ 伺服）。"""
    if not cfg:
        return ""
    clash = (cfg.get("experimental", {}) or {}).get("clash_api", {}) or {}
    if not clash.get("external_ui"):
        return ""
    parsed = urllib.parse.urlparse(settings["clash_api"])
    origin = f"{parsed.scheme or 'http'}://{parsed.netloc}"
    return f"{origin}/ui/"



# --------------------------------------------------------------------------- main


def build_server(settings: Settings) -> ThreadingHTTPServer:
    service = Service(settings)
    configs = ConfigManager(settings, service)
    subs = Subscriptions(settings, configs)
    handler = type(
        "BoundHandler",
        (Handler,),
        {
            "settings": settings,
            "service": service,
            "configs": configs,
            "ebpf": Ebpf(settings, configs),
            "clash": Clash(settings),
            "subs": subs,
            "geoip": GeoIP(settings),
        },
    )
    server = ThreadingHTTPServer((settings["listen"], int(settings["port"])), handler)
    SubscriptionScheduler(settings, subs).start()
    return server


def main() -> int:
    parser = argparse.ArgumentParser(description="sing-box panel backend")
    parser.add_argument("--config", help="面板配置文件（默认 /etc/sing-box/panel.json）")
    parser.add_argument("--port", type=int, help="覆盖监听端口")
    parser.add_argument("--listen", help="覆盖监听地址")
    parser.add_argument("--dry-run", action="store_true", help="不动 systemd，配置写到 /tmp（用于本地测试）")
    parser.add_argument("--print-token", action="store_true", help="打印访问令牌后退出")
    parser.add_argument("--version", action="version", version=f"sing-box-panel {VERSION}")
    args = parser.parse_args()

    settings = Settings(args.config, dry_run=args.dry_run)
    if args.port:
        settings.data["port"] = args.port
    if args.listen:
        settings.data["listen"] = args.listen

    if args.print_token:
        print(settings.token())
        return 0

    settings.token()   # 启动即确保令牌文件存在，避免"要令牌才能生成令牌"的死锁
    server = build_server(settings)
    log(f"sing-box panel {VERSION} 监听 http://{settings['listen']}:{settings['port']}/")
    if settings.token_created:
        log(f"首次运行，已生成访问令牌，请执行： sudo cat {settings.token_file}")
    else:
        log(f"访问令牌文件：{settings.token_file}（sudo cat 查看）")
    if settings.dry_run:
        log("dry-run 模式：不调用 systemctl，配置写 /tmp/sing-box-panel-dryrun-config.json")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        log("退出")
    return 0


if __name__ == "__main__":
    sys.exit(main())
