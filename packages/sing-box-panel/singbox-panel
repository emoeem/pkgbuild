class Clash:
    def __init__(self, settings: Settings):
        self.s = settings

    def _request(self, path: str, method: str = "GET", body: dict | None = None) -> tuple[bool, object]:
        base = self.s["clash_api"].rstrip("/")
        url = f"{base}{path}"
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(url, data=data, method=method)
        secret = self.s.clash_secret()
        if secret:
            req.add_header("Authorization", f"Bearer {secret}")
        if data:
            req.add_header("Content-Type", "application/json")
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                raw = resp.read().decode("utf-8", "replace")
                try:
                    return True, json.loads(raw)
                except ValueError:
                    return True, raw
        except urllib.error.HTTPError as exc:
            return False, f"HTTP {exc.code}"
        except Exception as exc:  # noqa: BLE001
            return False, str(exc)

    def proxies(self) -> dict:
        okc, data = self._request("/proxies")
        if not okc:
            return {"ok": False, "message": data, "proxies": {}}
        proxies = data.get("proxies", {}) if isinstance(data, dict) else {}
        groups, nodes = [], []
        for name, item in proxies.items():
            entry = {
                "name": name,
                "type": item.get("type"),
                "now": item.get("now", ""),
                "members": item.get("all", []) or [],
                "history": (item.get("history") or [{}])[-1].get("delay") if item.get("history") else None,
                "alive": item.get("alive"),
            }
            (groups if entry["members"] else nodes).append(entry)
        return {"ok": True, "groups": sorted(groups, key=lambda x: x["name"]), "nodes": nodes}

    def select(self, group: str, name: str) -> dict:
        okc, data = self._request(f"/proxies/{urllib.parse.quote(group)}", "PUT", {"name": name})
        return ok(f"已切换到 {name}") if okc else err(f"切换失败：{data}")

    def delay(self, name: str, url: str, timeout: int = 5000) -> dict:
        path = (
            f"/proxies/{urllib.parse.quote(name)}/delay"
            f"?url={urllib.parse.quote(url, safe='')}&timeout={int(timeout)}"
        )
        okc, data = self._request(path)
        if not okc:
            return {"ok": False, "message": str(data)}
        delay = data.get("delay") if isinstance(data, dict) else None
        return {"ok": True, "delay": delay, "message": (data.get("message") if isinstance(data, dict) else "")}

    def connections(self) -> dict:
        okc, data = self._request("/connections")
        return {"ok": okc, "data": data if okc else {}, "message": "" if okc else str(data)}

    def version(self) -> dict:
        okc, data = self._request("/version")
        return {"ok": okc, "data": data if okc else {}}


