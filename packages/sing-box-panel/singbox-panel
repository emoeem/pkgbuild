# --------------------------------------------------------------------------- 基础工具


def log(msg: str) -> None:
    print(f"[{time.strftime('%H:%M:%S')}] {msg}", flush=True)


def run(cmd: list[str], timeout: int = 30) -> tuple[int, str, str]:
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout.strip(), p.stderr.strip()
    except FileNotFoundError:
        return 127, "", f"命令不存在: {cmd[0]}"
    except subprocess.TimeoutExpired:
        return 124, "", f"超时({timeout}s): {' '.join(cmd)}"


def ok(msg: str) -> dict:
    return {"ok": True, "message": msg}


def err(msg: str) -> dict:
    return {"ok": False, "message": msg}


def strip_json5(text: str) -> str:
    """移除字符串外的 //、/* */ 注释和对象/数组尾逗号。"""
    without_comments = []
    in_string = False
    escaped = False
    index = 0
    while index < len(text):
        char = text[index]
        if in_string:
            without_comments.append(char)
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
            index += 1
            continue
        if char == '"':
            in_string = True
            without_comments.append(char)
            index += 1
            continue
        if char == "/" and index + 1 < len(text) and text[index + 1] == "/":
            index += 2
            while index < len(text) and text[index] not in "\r\n":
                index += 1
            continue
        if char == "/" and index + 1 < len(text) and text[index + 1] == "*":
            index += 2
            while index + 1 < len(text) and not (text[index] == "*" and text[index + 1] == "/"):
                index += 1
            index += 2
            continue
        without_comments.append(char)
        index += 1

    stripped = "".join(without_comments)
    normalized = []
    in_string = False
    escaped = False
    index = 0
    while index < len(stripped):
        char = stripped[index]
        if in_string:
            normalized.append(char)
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
            index += 1
            continue
        if char == '"':
            in_string = True
            normalized.append(char)
            index += 1
            continue
        if char == ",":
            next_index = index + 1
            while next_index < len(stripped) and stripped[next_index] in " \t\r\n":
                next_index += 1
            if next_index < len(stripped) and stripped[next_index] in "}]":
                index += 1
                continue
        normalized.append(char)
        index += 1
    return "".join(normalized)


def loads_config(text: str) -> dict:
    config = json.loads(strip_json5(text))
    if not isinstance(config, dict):
        raise ValueError("配置顶层必须是 JSON 对象")
    return config


def parse_userinfo(header: str) -> dict:
    """把 Subscription-Userinfo 的 upload/download/total/expire 解析为整数。"""
    info = {}
    for part in (header or "").split(";"):
        key, separator, value = part.strip().partition("=")
        key = key.lower()
        if not separator or key not in ("upload", "download", "total", "expire"):
            continue
        try:
            info[key] = int(value.strip())
        except ValueError:
            continue
    return info


def normalize_update_interval(value) -> int:
    try:
        seconds = int(value)
    except (TypeError, ValueError):
        return 0
    if seconds <= 0:
        return 0
    return min(max(seconds, 300), 30 * 86400)


# --------------------------------------------------------------------------- 面板设置


class Settings:
    def __init__(self, path: str | None, dry_run: bool = False):
        self.dry_run = dry_run
        file_data: dict = {}
        paths = [path] if path else ["/etc/sing-box/panel.json"]
        for cand in paths:
            if cand and os.path.exists(cand):
                try:
                    file_data = json.loads(Path(cand).read_text("utf-8"))
                except (OSError, ValueError) as exc:
                    log(f"读取面板配置 {cand} 失败：{exc}，使用默认值")
        base = dict(DEFAULT_CONFIG)
        base.update(file_data)
        # dry-run 只在配置**没有显式指定** state_dir 时才改用临时目录
        if dry_run and "state_dir" not in file_data:
            base["state_dir"] = os.environ.get("PANEL_STATE_DIR", "/tmp/sing-box-panel-state")
        self.data = base
        os.makedirs(self.data["state_dir"], exist_ok=True)
        self.token_file = Path(self.data["state_dir"]) / "token"
        self._secret_cache: tuple[int, str] | None = None
        self._egress_cache: tuple[float, str] | None = None
        self._egress_lock = threading.Lock()
        self.token_created = False

    def __getitem__(self, key: str):
        return self.data[key]

    def get(self, key: str, default=None):
        return self.data.get(key, default)

    # token -----------------------------------------------------------------
    def token(self) -> str:
        env = os.environ.get("PANEL_TOKEN")
        if env:
            return env
        if self.token_file.exists():
            value = self.token_file.read_text("utf-8").strip()
            if value:
                return value
        value = secrets.token_urlsafe(24)
        self.token_file.write_text(value + "\n", encoding="utf-8")
        os.chmod(self.token_file, 0o600)
        self.token_created = True
        return value

    # sing-box 配置路径 ------------------------------------------------------
    @property
    def sing_box_config(self) -> Path:
        return Path(self.data["sing_box_config"])

    def load_sing_box_config(self) -> dict:
        # sing-box 接受注释和尾逗号，json 模块不接受；统一用面板的解析器。
        return loads_config(self.sing_box_config.read_text("utf-8"))

    def dump_sing_box_config(self, obj: dict) -> str:
        return json.dumps(obj, ensure_ascii=False, indent=2) + "\n"

    def clash_secret(self) -> str:
        """从 sing-box 配置里读 Clash API 密钥；按文件 mtime 缓存，避免前端轮询时反复解析配置。"""
        try:
            mtime = self.sing_box_config.stat().st_mtime_ns
        except OSError:
            return ""
        if self._secret_cache and self._secret_cache[0] == mtime:
            return self._secret_cache[1]
        try:
            cfg = self.load_sing_box_config()
            value = str((cfg.get("experimental", {}).get("clash_api", {}) or {}).get("secret", ""))
        except Exception:
            value = ""
        self._secret_cache = (mtime, value)
        return value

    def egress_ip(self) -> str:
        """返回配置的出口 IP；可选地通过显式配置的探针 URL 获取并缓存。

        默认不发任何网络请求。只有用户在 panel.json 里设置
        egress_ip_probe_url 时才会访问该 URL；它只接收一次 GET，
        不包含任何连接目的地信息。
        """
        configured = str(self.data.get("egress_ip") or "").strip()
        if configured:
            try:
                ipaddress.ip_address(configured)
                return configured
            except ValueError:
                pass
        probe_url = str(self.data.get("egress_ip_probe_url") or "").strip()
        if not probe_url:
            return ""
        now = time.time()
        with self._egress_lock:
            if self._egress_cache is not None:
                stamp, value = self._egress_cache
                ttl = 6 * 3600 if value else 300
                if now - stamp < ttl:
                    return value
            value = ""
            try:
                request = urllib.request.Request(
                    probe_url, headers={"User-Agent": "sing-box-panel/" + VERSION}
                )
                with urllib.request.urlopen(request, timeout=5) as response:
                    candidate = response.read(128).decode("utf-8", "replace").strip()
                ipaddress.ip_address(candidate)
                value = candidate
            except Exception:  # noqa: BLE001
                value = ""
            self._egress_cache = (now, value)
            return value

    # 面板状态 ---------------------------------------------------------------
    @property
    def subs_file(self) -> Path:
        return Path(self.data["state_dir"]) / "subscriptions.json"

    @property
    def managed_file(self) -> Path:
        return Path(self.data["state_dir"]) / "managed.json"

    def read_json(self, path: Path, default):
        try:
            return json.loads(path.read_text("utf-8"))
        except (OSError, ValueError):
            return default

    def write_json(self, path: Path, obj) -> None:
        tmp = path.with_suffix(path.suffix + ".tmp")
        tmp.write_text(json.dumps(obj, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        os.replace(tmp, path)
        os.chmod(path, 0o600)

    def subscriptions(self) -> list:
        return self.read_json(self.subs_file, [])

    def managed(self) -> dict:
        return self.read_json(self.managed_file, {"outbound_tags": [], "group_members": {}})


# --------------------------------------------------------------------------- GeoIP


class GeoIP:
    """Lazy, in-memory City lookup. No query is logged or sent anywhere."""

    def __init__(self, settings: Settings):
        self.s = settings
        self.lock = threading.Lock()
        self.reader = None
        self.loaded = False
        self.error = ""
        self.path = ""

    def _paths(self) -> list[str]:
        candidates: list[str] = []
        configured = str(self.s.get("geoip_database") or "").strip()
        if configured:
            candidates.append(configured)
        for path in GEOIP_DEFAULT_PATHS:
            if path not in candidates:
                candidates.append(path)
        return candidates

    def _load(self) -> None:
        if self.loaded:
            return
        with self.lock:
            if self.loaded:
                return
            self.loaded = True
            if maxminddb is None:
                self.error = "python-maxminddb is not installed"
                log(f"GeoIP 不可用：{self.error}")
                return
            for path in self._paths():
                if not path or not Path(path).is_file():
                    continue
                try:
                    self.reader = maxminddb.open_database(path)
                    self.path = path
                    self.error = ""
                    log(f"GeoIP 数据库：{path}")
                    return
                except Exception as exc:  # noqa: BLE001
                    self.error = str(exc)
            if not self.error:
                self.error = "database not found"
            log(f"GeoIP 不可用：{self.error}")

    def lookup(self, ip: str) -> tuple[dict, int]:
        try:
            address = ipaddress.ip_address(ip.strip())
        except ValueError:
            return err("private or unresolvable ip"), 404
        if not address.is_global:
            return err("private or unresolvable ip"), 404
        self._load()
        if self.reader is None:
            return err("geoip database unavailable"), 503
        try:
            data = self.reader.get(str(address))
        except Exception:  # noqa: BLE001
            return err("private or unresolvable ip"), 404
        if not isinstance(data, dict):
            return err("private or unresolvable ip"), 404
        location = data.get("location") or {}
        longitude = location.get("longitude")
        latitude = location.get("latitude")
        if not isinstance(longitude, (int, float)) or not isinstance(latitude, (int, float)):
            return err("private or unresolvable ip"), 404
        country = (data.get("country") or {}).get("iso_code") or ""
        city = ((data.get("city") or {}).get("names") or {}).get("en") or ""
        return {
            "ok": True,
            "ip": str(address),
            "lon": float(longitude),
            "lat": float(latitude),
            "country": str(country),
            "city": str(city),
        }, 200


# --------------------------------------------------------------------------- 服务控制


class Service:
    def __init__(self, settings: Settings):
        self.s = settings

    def status(self) -> dict:
        unit = self.s["service"]
        if self.s.dry_run:
            return {"active": False, "enabled": False, "since": "", "pid": "", "dry_run": True}
        _, active, _ = run(["systemctl", "is-active", unit])
        _, enabled, _ = run(["systemctl", "is-enabled", unit])
        rc, out, _ = run(["systemctl", "show", "-p", "ActiveEnterTimestamp", "-p", "MainPID", unit])
        fields = dict(
            line.split("=", 1) for line in out.splitlines() if "=" in line
        )
        return {
            "active": active == "active",
            "enabled": enabled in ("enabled", "enabled-runtime"),
            "since": fields.get("ActiveEnterTimestamp", ""),
            "pid": fields.get("MainPID", ""),
            "raw": active,
        }

    def control(self, action: str) -> dict:
        if action not in ("start", "stop", "restart", "reload"):
            return err(f"不支持的操作：{action}")
        if self.s.dry_run:
            return ok(f"[dry-run] 跳过 systemctl {action} {self.s['service']}")
        rc, _, e = run(["systemctl", action, self.s["service"]], timeout=60)
        if rc != 0:
            return err(f"systemctl {action} 失败：{e or rc}")
        return ok(f"已执行 systemctl {action} {self.s['service']}")

    def journal(self, lines: int = 200) -> str:
        if self.s.dry_run:
            return "(dry-run：无日志)"
        _, out, _ = run(
            ["journalctl", "-u", self.s["service"], "-n", str(lines), "--no-pager", "-o", "short-iso"],
            timeout=20,
        )
        return out

    def wait_healthy(self) -> tuple[bool, str]:
        """重启后等它真的可用：is-active（TUN 模式再等 tun0，eBPF 模式等 eBPF 挂载迹象）。"""
        if self.s.dry_run:
            return True, "[dry-run] 跳过健康检查"
        unit = self.s["service"]
        deadline = time.time() + float(self.s["restart_timeout"])
        last = ""
        while time.time() < deadline:
            _, active, _ = run(["systemctl", "is-active", unit])
            last = active
            if active == "active":
                break
            time.sleep(0.5)
        if last != "active":
            return False, f"服务未在 {self.s['restart_timeout']}s 内 active（当前：{last or 'unknown'}）"
        try:
            cfg = self.s.load_sing_box_config()
        except Exception as exc:
            return False, f"配置无法读取：{exc}"
        types = {i.get("type") for i in cfg.get("inbounds", [])}
        if "tun" in types:
            while time.time() < deadline:
                if Path("/sys/class/net/tun0").exists() or run(["ip", "link", "show", "tun0"])[0] == 0:
                    break
                time.sleep(0.5)
            else:
                return False, "服务 active 但 tun0 未出现"
        probe = self.s.get("health_probe_url") or ""
        if probe:
            proxy = self._mixed_proxy(cfg)
            if proxy:
                rc, _, _ = run(["curl", "-s", "-m", "10", "-x", proxy, "-o", "/dev/null", probe], timeout=20)
                if rc != 0:
                    return False, f"经代理探测 {probe} 失败"
        return True, "服务已恢复健康"

    @staticmethod
    def _mixed_proxy(cfg: dict) -> str:
        for i in cfg.get("inbounds", []):
            if i.get("type") in ("mixed", "http"):
                host = i.get("listen", "127.0.0.1")
                port = i.get("listen_port")
                if port:
                    return f"http://{host}:{port}"
        return ""


# --------------------------------------------------------------------------- 配置安全管线


class ConfigManager:
    def __init__(self, settings: Settings, service: Service):
        self.s = settings
        self.service = service
        self.lock = threading.Lock()

    # 备份 -------------------------------------------------------------------
    def backup_dir(self) -> Path:
        d = self.s.sing_box_config.parent / "backups"
        d.mkdir(parents=True, exist_ok=True)
        return d

    def backup(self, reason: str) -> str:
        src = self.s.sing_box_config
        if not src.exists():
            return ""
        name = f"config.{time.strftime('%Y%m%d-%H%M%S')}.{re.sub(r'[^a-zA-Z0-9_-]', '-', reason)[:24]}.json"
        dst = self.backup_dir() / name
        shutil.copy2(src, dst)
        self.prune_backups()
        return name

    def prune_backups(self) -> None:
        keep = int(self.s.get("backup_keep", 30))
        files = sorted(self.backup_dir().glob("config.*.json"))
        for old in files[:-keep] if keep > 0 else []:
            try:
                old.unlink()
            except OSError:
                pass

    def list_backups(self) -> list:
        out = []
        for f in sorted(self.backup_dir().glob("config.*.json"), reverse=True):
            st = f.stat()
            out.append({"name": f.name, "size": st.st_size, "mtime": int(st.st_mtime)})
        return out

    # check ------------------------------------------------------------------
    def check(self, cfg: dict) -> tuple[bool, str]:
        """用 sing-box check 校验。副本里把 cache_file 指到 /tmp，避免污染服务自己的 cache.db。"""
        probe = json.loads(json.dumps(cfg))
        cache = (probe.get("experimental", {}) or {}).get("cache_file")
        if isinstance(cache, dict) and cache.get("path"):
            cache["path"] = "/tmp/sing-box-panel-check-cache.db"
        # 用 mkstemp 而不是固定 /tmp 路径：内核 fs.protected_regular=1 时，
        # root 无法写 /tmp 下属于其他用户的已存在文件（EACCES），固定路径会偶发失败。
        fd, tmp_path = tempfile.mkstemp(prefix="sing-box-panel-check-", suffix=".json")
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as fh:
                json.dump(probe, fh, ensure_ascii=False, indent=2)
            os.chmod(tmp_path, 0o600)
            rc, out, e = run([self.s["sing_box_bin"], "check", "-c", tmp_path], timeout=60)
        finally:
            try:
                os.unlink(tmp_path)
            except OSError:
                pass
        if rc == 0:
            return True, e or out or "check 通过"
        return False, (e or out or f"check 退出码 {rc}").strip()

    # 应用 -------------------------------------------------------------------
    def apply(self, new_cfg: dict, reason: str, restart: bool = True) -> dict:
        with self.lock:
            okc, msg = self.check(new_cfg)
            if not okc:
                return err(f"配置校验未通过，未做任何改动：{msg}")

            backup_name = ""
            if not self.s.dry_run:
                backup_name = self.backup(reason)
            target = self.s.sing_box_config
            if self.s.dry_run:
                fd, dry_path = tempfile.mkstemp(prefix="sing-box-panel-dryrun-", suffix=".json")
                with os.fdopen(fd, "w", encoding="utf-8") as fh:
                    fh.write(self.s.dump_sing_box_config(new_cfg))
                return ok(f"[dry-run] 校验通过，已写入 {dry_path}（未重启）")

            previous = target.read_text("utf-8") if target.exists() else ""
            tmp = target.with_suffix(".json.panel-tmp")
            tmp.write_text(self.s.dump_sing_box_config(new_cfg), encoding="utf-8")
            os.chmod(tmp, 0o644)
            os.replace(tmp, target)

            if not restart:
                return {"ok": True, "message": "配置已写入（未重启）", "backup": backup_name}

            rc, _, e = run(["systemctl", "restart", self.s["service"]], timeout=60)
            if rc != 0:
                return self._rollback(previous, f"重启失败：{e or rc}", backup_name)

            healthy, why = self.service.wait_healthy()
            if not healthy:
                return self._rollback(previous, why, backup_name)

            return {"ok": True, "message": f"配置已应用并重启成功（{why}）", "backup": backup_name}

    def _rollback(self, previous: str, why: str, backup_name: str) -> dict:
        if previous:
            self.s.sing_box_config.write_text(previous, encoding="utf-8")
            run(["systemctl", "restart", self.s["service"]], timeout=60)
        return err(f"{why}；已回滚到应用前的配置（备份 {backup_name or '无'}）")

    def restore(self, name: str) -> dict:
        src = self.backup_dir() / name
        if not src.exists():
            return err(f"找不到备份 {name}")
        try:
            cfg = loads_config(src.read_text("utf-8"))
        except (OSError, ValueError) as exc:
            return err(f"备份内容不是合法 JSON：{exc}")
        return self.apply(cfg, f"restore-{name}", restart=True)


# --------------------------------------------------------------------------- eBPF


class Ebpf:
    def __init__(self, settings: Settings, configs: ConfigManager):
        self.s = settings
        self.configs = configs

    def inbound(self, cfg: dict | None = None) -> dict | None:
        cfg = cfg if cfg is not None else self.s.load_sing_box_config()
        for i in cfg.get("inbounds", []):
            if i.get("type") == "ebpf":
                return i
        return None

    def policy(self) -> dict:
        cfg = self.s.load_sing_box_config()
        inbound = self.ebpf_inbound(cfg)
        if not inbound:
            return {"present": False, "mode": "none", "uids": [], "local": {}}
        local = inbound.get("local", {}) or {}
        include = list(local.get("include_uid", []) or [])
        exclude = list(local.get("exclude_uid", []) or [])
        if include:
            mode, uids = "whitelist", include
        elif exclude:
            mode, uids = "blacklist", exclude
        else:
            mode, uids = "off", []
        return {
            "present": True,
            "mode": mode,
            "uids": sorted(set(int(u) for u in uids)),
            "include": include,
            "exclude": exclude,
            "data_plane": local.get("data_plane", "cgroup"),
            "dns_mode": local.get("dns_mode", "hijack"),
            "ipv6": local.get("ipv6", True),
            "shared": inbound.get("shared", {}),
        }

    def set_policy(self, mode: str, uids: list[int]) -> dict:
        if mode not in ("off", "blacklist", "whitelist"):
            return err(f"未知模式：{mode}")
        cfg = self.s.load_sing_box_config()
        inbound = self.ebpf_inbound(cfg)
        if not inbound:
            return err("当前配置里没有 ebpf 入站（面板只支持在 eBPF 模式下管理分应用策略）")
        local = inbound.setdefault("local", {})
        uids = sorted({int(u) for u in uids if 0 <= int(u) < 2**32})
        local.pop("include_uid", None)
        local.pop("exclude_uid", None)
        if mode == "whitelist" and uids:
            local["include_uid"] = uids
        elif mode == "blacklist" and uids:
            local["exclude_uid"] = uids
        elif mode != "off":
            mode = "off"
        return self.configs.apply(cfg, f"ebpf-policy-{mode}")

    def probe(self, interface: str | None = None) -> dict:
        if self.s.dry_run:
            return {"ok": True, "result": "dry-run", "findings": []}
        cmd = [self.s["sing_box_bin"], "tools", "ebpf", "status", "--mode", "all", "--json"]
        if interface:
            cmd += ["--interface", interface]
        rc, out, e = run(cmd, timeout=120)
        try:
            data = json.loads(out)
        except ValueError:
            data = {"findings": [], "raw": out, "stderr": e}
        data["exit_code"] = rc
        summary = data.get("summary") or {}
        data["ok"] = rc == 0 and not summary.get("required_issues")
        return data

    # 兼容不同版本的字段名
    def ebpf_inbound(self, cfg: dict) -> dict | None:
        return self.inbound(cfg)


